{
  "enabledPlugins": {
    "vrcel@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"${CLAUDE_PROJECT_DIR}\\scripts\\graphify-session-context.ps1\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/intelligence-context.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/check-memory-index.mjs\" --quiet",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/session-lease-status.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/skills-first-reminder.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/skill-recall.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/pretool.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/lease-check.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?:Monitor|mcp__.+__(?:run_in_terminal|start_process|interact_with_process|write_file|edit_file|edit_block|write_pdf|move_file|run_sql|run_sql_transaction|explain_sql_statement|complete_database_migration|execute_sql_query|execute_prisma_postgres_schema_update|accept-deploy|connect-service-source|create-deployment|create-function|create-service|delete-bucket|delete-domain|delete-feature-flag|delete-service|delete-tcp-proxy|delete-volume|delete-webhook|deploy-template|railway-agent|redeploy|reset-bucket-credentials|restart-service|set-feature-flag|set-variables|update-bucket|update-domain|update-function-source-code|update-service|update-volume|update-webhook|add_auth_oauth_provider|add_auth_trusted_domain|complete_query_tuning|create_credential|delete_auth_oauth_provider|delete_auth_trusted_domain|delete_auth_user|delete_branch|delete_data_api|delete_function|delete_functions_custom_domain|delete_postgres_database|delete_postgres_endpoint|delete_postgres_role|delete_project|delete_snapshot|delete_storage_bucket|delete_storage_object|delete_storage_objects_by_prefix|delete_trigger|deploy_function|disable_auth|finalize_branch_restore|reset_from_parent|reset_postgres_role_password|restart_postgres_endpoint|restore_snapshot|revoke_credential|rotate_credential|set_default_branch|suspend_postgres_endpoint|update_auth_config|update_auth_oauth_provider|update_auth_user_role|update_branch|update_data_api|update_function|update_postgres_database|update_postgres_endpoint|update_project|update_snapshot|update_trigger|accept_project_transfer_request|activate_kms_signing_key|add_project_domain|add_route|approve_rolling_release_stage|assign_alias|buy_domain|cancel_deployment|complete_rolling_release|create_deployment|create_edge_config_token|create_kms_signing_key|create_or_transfer_domain|create_project_env|create_record|create_sdk_key|edit_project_env|edit_route|issue_cert|patch_edge_config_items|patch_url_protection_bypass|pause_project|put_firewall_config|replace_domain_dns_records|request_promote|request_rollback|restore_edge_config_backup|restore_redirects|revoke_kms_signing_key|run_session_command|stage_redirects|stage_routes|start_rolling_release|unpause_project|update_attack_challenge_mode|update_bulk_redirect_version|update_connector|update_edge_config|update_firewall_config|update_flag|update_flag_segment|update_flag_settings|update_kms_issuer|update_kms_issuer_policy|update_project_protection_bypass|update_record|update_rolling_release_config|update_route_versions|upsert_connector_project_connection|write_session_files|create_object_store_bucket_key|create_prisma_postgres_connection_string|create_prisma_postgres_recovery|delete_object_store_bucket|delete_object_store_bucket_key|delete_prisma_compute_app|delete_prisma_compute_deployment|delete_prisma_compute_env_var|delete_prisma_postgres_connection_string|delete_prisma_postgres_database|link_prisma_github_repository|promote_prisma_compute_deployment|rollback_prisma_compute_app|set_prisma_compute_env_var|start_prisma_compute_deployment|stop_prisma_compute_deployment))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/pretool.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?:Monitor|mcp__.+__(?:run_in_terminal|start_process|interact_with_process|write_file|edit_file|edit_block|write_pdf|move_file))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/lease-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-os/stop-check.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm agent:verify)",
      "Bash(node scripts/agent-os/verify.mjs)",
      "Bash(railway status)",
      "Bash(railway logs *)",
      "Bash(pnpm run check)",
      "Bash(pnpm run check 2>&1)",
      "Bash(railway deployment list *)",
      "Bash(node scripts/agent-os/verify.mjs 2>&1)",
      "Bash(curl -s --max-time 15 https://nickstire.org/api/health)",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__get-logs",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__list-deployments",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__list-projects",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__list-services",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__get-service-config",
      "mcp__16f59cb5-d119-4072-a423-ec2e39a6ecb8__environment-status",
      "mcp__ccd_pr__get_status",
      "mcp__terminal__read_terminal"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(git push origin HEAD:main)",
      "PowerShell(git push origin main)",
      "PowerShell(git push -u origin main)",
      "PowerShell(git push origin HEAD:main)"
    ]
  }
}
