#!/usr/bin/env sh
# Husky pre-commit hook — runs fast parallelized checks before every commit.
#
# Optimized: TypeScript check deferred to pre-push to keep local commits instant.
# Runs lints and route validation concurrently.

set -e

# Detect whether any nickstire files are staged. If not, skip checks.
NICKSTIRE_STAGED=$(git diff --cached --name-only | grep -c "^apps/nickstire/" || true)

if [ "$NICKSTIRE_STAGED" -gt 0 ]; then
  echo "[pre-commit] $NICKSTIRE_STAGED nickstire file(s) staged → running parallel lints"

  # Run all lints concurrently in subshells
  (cd apps/nickstire && pnpm run lint:brand-voice) &
  P1=$!
  
  (cd apps/nickstire && pnpm run lint:source) &
  P2=$!
  
  (cd apps/nickstire && pnpm run lint:hooks) &
  P3=$!
  
  (cd apps/nickstire && pnpm run lint:pii) &
  P4=$!
  
  (cd apps/nickstire && pnpm run validate:routes) &
  P5=$!

  # Wait for all processes and accumulate exit codes
  wait $P1 || { echo "[pre-commit] ❌ Brand-voice lint failed"; exit 1; }
  wait $P2 || { echo "[pre-commit] ❌ Source lint failed"; exit 1; }
  wait $P3 || { echo "[pre-commit] ❌ Hooks lint failed"; exit 1; }
  wait $P4 || { echo "[pre-commit] ❌ PII lint failed"; exit 1; }
  wait $P5 || { echo "[pre-commit] ❌ Route validation failed"; exit 1; }

  echo "[pre-commit] All parallel lints passed."
else
  echo "[pre-commit] no nickstire files staged → skipping checks"
fi

echo "✓ pre-commit OK"
