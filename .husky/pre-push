#!/usr/bin/env sh
# Husky pre-push hook — runs typechecking and build for any app touched since origin.
#
# Why this exists: Catches typechecking and Next.js prerender errors
# locally before pushing to remote / triggering Railway build pipeline.
#
# Strategy: runs `check` (TypeScript check) and `build` via Turborepo.
# Affected detection resolves dependencies since the upstream tracking branch.

set -e

# Skip during initial pushes when no remote tracking exists yet
if ! git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  echo "[pre-push] no upstream tracking branch · skipping affected check"
  exit 0
fi

# Skip if pushing to a tag
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*) echo "[pre-push] tag push · skipping"; exit 0 ;;
  esac
done

echo "[pre-push] running affected typecheck + build..."

# Use the project's own pnpm + turbo
if [ ! -x "./node_modules/.bin/turbo" ]; then
  echo "[pre-push] turbo not found · run 'pnpm install' first"
  exit 1
fi

# self-heal stale .next/lock from a prior aborted build
for lock in apps/*/.next/lock; do
  if [ -e "$lock" ]; then
    echo "[pre-push] removing stale lock · $lock"
    rm -f "$lock"
  fi
done

UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)

# Run check and build in parallel for affected packages
./node_modules/.bin/turbo run check build --filter="...[$UPSTREAM]" --output-logs=errors-only || {
  echo ""
  echo "[pre-push] ❌ affected check/build FAILED"
  echo "[pre-push] fix the type or build errors above before pushing"
  exit 1
}

echo "✓ pre-push affected checks OK"
