{
  "name": "@statenour/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Statenour worker · runs long-running crons + LLM orchestration off the web service. Triggers Railway-cron HTTP endpoints (mega/mega-evening) + in-process node-cron loop for high-frequency jobs. See docs/MIGRATION_PLAN.md §3.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@nour/reel-engine": "workspace:*",
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.20",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
