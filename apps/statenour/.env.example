# ═══════════════════════════════════════════════════════════════════════
# STATENOUR OS · .env.example  (v11.0 · observability + power deck)
# ═══════════════════════════════════════════════════════════════════════

# ── Database (Neon Postgres) ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth (NextAuth + Google) ────────────────────────────────────────────
AUTH_SECRET="replace_me"
AUTH_GOOGLE_CLIENT_ID="replace_me"
AUTH_GOOGLE_CLIENT_SECRET="replace_me"
AUTH_ALLOWED_EMAIL="you@example.com"
# Dev shortcut — set to "1" to skip auth entirely in local preview. Do
# NOT enable this in production.
LOCAL_DEV_BYPASS_AUTH="0"
# Demo fallback session (non-prod only)
AUTH_MOCK_USER_ID="operator-1"
AUTH_MOCK_USER_NAME="Nick Statenour"
AUTH_MOCK_USER_EMAIL="operator@statenour.local"
# ── Auth escape hatches (DANGEROUS — keep unset / "0" in production) ─────
# AUTH_FORCE_MOCK=1 bypasses Google OAuth even when all creds are present
# (local dev where localhost isn't a registered redirect URI). Read by
# auth.ts + middleware.ts. Never set on bdnick.info.
AUTH_FORCE_MOCK="0"
# AUTH_ALLOW_MOCK_IN_PROD=1 is the ONLY switch that permits mock-auth
# (auto-login as the mock operator) in production — intended for preview
# deploys without wired OAuth. lib/auth-guard.ts emits a CRITICAL event
# whenever it is active. MUST remain unset on prod. Blank = fail-closed.
AUTH_ALLOW_MOCK_IN_PROD=""
# Bearer token the apps/voice Python worker uses to call /api/agent without
# a browser session (middleware whitelists /api/agent; the route accepts
# this token OR a real session). Unset = voice bridge is session-only.
VOICE_BRIDGE_TOKEN="replace_me"

# ── Public URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://bdnick.info"
NEXT_PUBLIC_NICKSTIRE_URL="https://nickstire.org"
# Alias some code paths read — keep in sync with NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SITE_URL="https://bdnick.info"
# Required by NextAuth in non-Vercel environments; Vercel auto-derives it
# NEXTAUTH_URL="https://bdnick.info"
# Internal link back to the business admin
NICKS_ADMIN_URL="https://nickstire.org/admin"

# ── Sync / Cron / Runner ────────────────────────────────────────────────
STATENOUR_SYNC_KEY="replace_me"                        # shared secret for /api/sync/* + /api/cron/trigger
CRON_SECRET="replace_me"                               # Vercel cron auth
RUNNER_SHARED_SECRET="replace_me"                      # Windows local runner ↔ app
RUNNER_USE_QUEUE="true"
DEVICE_SYNC_KEY="replace_me"                           # device heartbeats

# ── Bridge to Nick's Admin (nickstire.org) ─────────────────────────────
BRIDGE_API_KEY="replace_me"
NICKSTIRE_URL="https://nickstire.org"
NICKSTIRE_BRIDGE_URL="https://nickstire.org"
SYNC_SECRET="replace_me"

# ── AI providers (chain: Ollama Cloud primary → Gemini → OpenAI → Anthropic · Venice retired)
# Provider override — normally auto. Set to "ollama" | "gemini" | "openai" | "anthropic" to pin.
# AI_PROVIDER="ollama"
OLLAMA_API_KEY="replace_me"
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_MODEL="gpt-oss:120b"
OLLAMA_VISION_MODEL="qwen3-vl:235b-instruct"
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY="AI..."
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
XAI_API_KEY="xai-..."
HUGGINGFACE_API_KEY="hf_..."
PERPLEXITY_API_KEY="pplx-..."

# ── Notifications ───────────────────────────────────────────────────────
# Email (Resend)
RESEND_API_KEY="re_..."
# Telegram (bot webhook + phone push)
TELEGRAM_BOT_TOKEN="..."
TELEGRAM_CHAT_ID="..."
TELEGRAM_WEBHOOK_SECRET="replace_me"                   # X-Telegram-Bot-Api-Secret-Token
# SMS (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."
NOUR_PHONE_NUMBER="+1..."
# Web Push (PWA) · generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@yourdomain.com"

# ── Payments ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── External services ───────────────────────────────────────────────────
# Weather (nickstire campaign triggers use this)
OPENWEATHER_API_KEY="..."
OPENWEATHER_CITY="Euclid,OH,US"
# Market quotes (wealth dashboard "Refresh Prices"). Optional but recommended:
# keyless sources (Yahoo/Stooq) block datacenter IPs, so without this the
# refresh can't fetch prices from Railway. Free key at https://finnhub.io.
FINNHUB_API_KEY="..."
# Google data
GOOGLE_PLACES_API_KEY="..."
GOOGLE_PLACE_ID="..."
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
GOOGLE_BUSINESS_URL="https://g.page/..."
# Smart home (Tuya)
TUYA_ACCESS_ID="..."
TUYA_ACCESS_SECRET="..."
TUYA_API_ENDPOINT="https://openapi.tuyaus.com"
# Integration stack
APOLLO_API_KEY="..."
CLICKUP_API_KEY="pk_..."
CLICKUP_DEFAULT_LIST_ID="..."
FIREFLIES_API_KEY="..."
MAKE_WEBHOOK_URL="https://hook.make.com/..."
MAKE_WEBHOOK_SECRET="replace_me"
MAKE_WEBHOOK_API_KEY="replace_me"
# Shop-side vendor credentials (local agent only)
AUTOLABOR_USERNAME="..."
AUTOLABOR_PASSWORD="..."
DKTIRE_USERNAME="..."
DKTIRE_PASSWORD="..."
# Shop labor defaults
SHOP_LABOR_RATE="120"
DAILY_REVENUE_TARGET="800"

# ── Redis L2 cache (optional — degrades to in-memory L1 when unset) ───
# Upstash free tier works: https://upstash.com → create DB → copy Redis URL
# REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"
# REDIS_KEY_PREFIX="statenour:"

# ── Build + deploy ──────────────────────────────────────────────────────
# Local build-dev isolation (see package.json build:local)
# NEXT_DIST_DIR=".next-prod"
# Vercel deploy helpers (set by Vercel in prod, optional locally).
# Required for the Builder Sandbox "rollback deploy" action (D1).
# Without VERCEL_TOKEN the rollback endpoint returns 501 (graceful).
# VERCEL_TOKEN="..."
# VERCEL_TEAM_ID="team_..."
# VERCEL_PROJECT_ID="prj_..."
# GITHUB_TOKEN="ghp_..."

# ── Browser-use agent (G1 · v11.1, pending) ────────────────────────────
# Sign up at browserbase.com (Google auth, 2 min). Drop keys here to
# light up the in-chat browser agent.
# BROWSERBASE_API_KEY="..."
# BROWSERBASE_PROJECT_ID="..."

# ── VideoDB · audio drop → transcript (v10.0.349) ──────────────────────
# Free tier · 50 uploads, no credit card. Sign up at console.videodb.io.
# Without this key, the chat audio-attach button returns 503 gracefully.
# VIDEO_DB_API_KEY="sk-xxx"

# ── Cohere · cross-encoder reranker (v10.0.363) ────────────────────────
# Free trial: 1000 reranks/month. Sign up at https://cohere.com.
# Without this key, brain recall falls back to RRF-only ordering · still
# works · just lower top-K precision. Wisdom/principle queries benefit
# most from rerank lift.
# COHERE_API_KEY="..."

# ── Wave AG · HuggingFace Inference (BGE rerank backend) ───────────────
# BAAI/bge-reranker-v2-m3 via HF Inference API is $0.0001/call vs
# Cohere's $2/1000 calls — 5000x cheaper for the same recall lift.
# The lib/brain/rerank.ts orchestrator routes between them via BGE_RERANK.
# HF_API_KEY="hf_..."                # https://huggingface.co/settings/tokens (read scope)
# BGE_RERANK="true"                  # Flip to prefer BGE over Cohere
# BGE_RERANK_MODEL="BAAI/bge-reranker-v2-m3"   # Override default model
# Full runbook: docs/runbooks/bge-rerank-cutover.md

# ── Wave AH · HuggingFace Inference (embedding backend) ────────────────
# HF backend inserted between Cohere and OpenAI in the embedding fallback
# chain (see lib/ai/provider.ts getEmbedding). Default model:
# intfloat/multilingual-e5-large · 1024-dim · supports Spanish + 100 langs.
# HF_API_KEY="hf_..."                                # SAME key as Wave AG · reuse
# HF_EMBED_MODEL="intfloat/multilingual-e5-large"    # Override default model
# Full runbook: docs/runbooks/hf-embeddings-cutover.md

# ── Wave AJ · Replicate FLUX image generation ──────────────────────────
# Replicate flux-schnell at $0.003/img vs metered APIs at $0.04/img ·
# 12-20x cost reduction at comparable quality. Image generation checks
# REPLICATE_FLUX and delegates to replicate-flux.ts when ON.
# REPLICATE_API_KEY="r8_..."                          # https://replicate.com/account/api-tokens
# REPLICATE_FLUX="true"                               # Flip to route through Replicate
# REPLICATE_FLUX_MODEL="flux-schnell"                 # flux-schnell (default · cheap) | flux-dev (quality)
# REPLICATE_FLUX_SCHNELL_VERSION=""                   # Override pinned schnell version
# REPLICATE_FLUX_DEV_VERSION=""                       # Override pinned dev version
# Full runbook: docs/runbooks/replicate-flux-cutover.md

# ── Firecrawl · web scraping for AI (v10.0.530) ────────────────────
# Converts any URL into clean LLM-ready markdown. Used by Nick's
# scrapeWebPage tool when the operator shares a link. Free tier: 500
# pages/month. Sign up at https://firecrawl.dev.
# Without this key, scrapeWebPage returns a clear 'not configured' error.
# FIRECRAWL_API_KEY="fc-..."

# ── Gmail · inbox triage + draft reply (v10.0.379) ────────────────────
# One-time OAuth setup via Google's OAuth playground · see
# docs/gmail-setup.md for the step-by-step. Reuses AUTH_GOOGLE_CLIENT_ID
# and AUTH_GOOGLE_CLIENT_SECRET above. Without this, Nick's gmail
# tools return a graceful 'not configured' error.
# GMAIL_REFRESH_TOKEN="1//..."

# ── Auto-set by the runtime (listed for reference only, do NOT paste) ──
# Vercel injects: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA,
#                 VERCEL_GIT_COMMIT_REF, VERCEL_PROJECT_PRODUCTION_URL,
#                 VERCEL_OIDC_TOKEN, VERCEL_TARGET_ENV, AWS_LAMBDA_FUNCTION_NAME
# Node injects:   NODE_ENV, PORT

# ── Debug toggles ───────────────────────────────────────────────────────
# QUIET_DB_LOG="1"  # silence per-query timing logs in dev
# DEBUG_SQL="1"     # log raw Prisma SQL queries to console

# ── Operational / Script Gates ──────────────────────────────────────────
# APP_BASE_URL="https://bdnick.info"    # internal base URL for cron link generation
# BUILD_TIME="2026-06-21T00:00:00Z"   # deploy timestamp surfaced in health digest
# DAILY_AI_BUDGET_CENTS="750"          # daily AI spend cap in cents (cost SLO gate)
# NARRATOR_LLM_SYNTHESIS="1"           # enable Ultron narrator LLM synthesis
# NICK_PRIME_PROMPT="1"                # toggle Nick prime prompt variant
# OPERATOR_EMAIL="you@example.com"     # fallback operator email for brain inference
# GEMINI_MODEL="gemini-2.0-flash"      # override Gemini model for Google Search
# PRE_PUSH_SKIP="0"                    # dev escape hatch — set to "1" to skip pre-push checks
# ALLOW_PROD_WRITES="0"                # DANGEROUS — set to "1" to permit prod mutations in scripts
# CONFIRM_PROD="0"                     # DANGEROUS — set to "1" to confirm prod operations in scripts
# POLICY_GATE_HARD="0"                 # CI gate — set to "1" to enforce hard policy checks
# POLICY_GATE_SOFT="0"                 # CI gate — set to "1" to enforce soft policy warnings

# ── Obsidian Cockpit Integration ─────────────────────────────────────────
# Path to your local Obsidian vault folder (absolute path)
OBSIDIAN_VAULT_PATH="C:\\path\\to\\your\\Obsidian Vault"
# Path to iCloud Shortcuts directory (absolute path)
ICLOUD_SHORTCUTS_PATH="C:\\path\\to\\iCloudDrive\\iCloud~is~workflow~my~workflows"
# Local REST API plugin token (optional, handled locally/manually)
OBSIDIAN_REST_TOKEN="your_local_rest_api_token_here"
# Sync mode configuration: "bidirectional" | "obsidian_to_statenour" | "none"
OBSIDIAN_SYNC_MODE="bidirectional"

# Apple Health / iOS-Shortcut ingest (POST /api/health/summary).
# Endpoint is header-authed (x-statenour-health-sync-secret, constant-time
# compare) and middleware-whitelisted 2026-07-09. Unset = endpoint rejects all.
STATENOUR_HEALTH_SYNC_SECRET=
