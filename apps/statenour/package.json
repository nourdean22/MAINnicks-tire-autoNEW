{
  "name": "@statenour/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "prisma generate && next build",
    "build:local": "cross-env NEXT_DIST_DIR=.next-prod prisma generate && cross-env NEXT_DIST_DIR=.next-prod next build",
    "analyze": "cross-env ANALYZE=true NEXT_DIST_DIR=.next-prod prisma generate && cross-env ANALYZE=true NEXT_DIST_DIR=.next-prod next build",
    "build:check": "cross-env NEXT_DIST_DIR=.next-prod next build",
    "build:push-schema": "prisma generate && prisma db push && next build",
    "verify:hard": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:raw-sql && pnpm check:crons && cross-env STALE_DOCS_STRICT=1 pnpm check:stale-docs && pnpm prompt:size-check && pnpm exec prisma validate",
    "release:db": "prisma migrate deploy",
    "release:app": "prisma generate && next build",
    "release:full": "pnpm verify:hard && pnpm release:db && pnpm release:app",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "audit:surfaces": "node scripts/audit-system-surfaces.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "check:env:prod": "tsx scripts/check-env.ts --prod",
    "check:crons": "tsx scripts/verify-crons.ts",
    "check:stale-docs": "tsx scripts/check-stale-docs.ts",
    "check:runbooks": "tsx scripts/check-runbooks.ts",
    "check:raw-sql": "tsx scripts/audit-raw-sql-columns.ts",
    "check:secrets": "tsx scripts/scan-secrets.ts",
    "check:prompt-injection": "tsx scripts/scan-prompt-injection.ts",
    "check:lint-baseline": "tsx scripts/lint-baseline.ts --verify",
    "lint-baseline:snapshot": "tsx scripts/lint-baseline.ts --snapshot",
    "check:audit-deps": "tsx scripts/audit-deps.ts",
    "pre-push": "tsx scripts/pre-push-check.ts",
    "prompt:size-check": "tsx scripts/measure-prompt-size.ts --yes",
    "pins:smoke": "tsx scripts/smoke-pins.ts",
    "calibrate:dry": "tsx scripts/dry-run-auto-calibrate.ts --yes",
    "inngest:dev": "inngest-cli dev -u http://localhost:3001/api/inngest",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx tests/eval/run-suite.ts",
    "eval:memory": "tsx scripts/run-memory-evals.ts",
    "eval:live": "tsx tests/eval/run-suite.ts --live",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "bootstrap:repo": "powershell -ExecutionPolicy Bypass -File .\\scripts\\bootstrap_repo.ps1",
    "bootstrap:repo:dry": "powershell -ExecutionPolicy Bypass -File .\\scripts\\bootstrap_repo.ps1 -DryRun",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "install-hooks": "bash scripts/install-hooks.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "3.0.83",
    "@ai-sdk/openai": "^3.0.74",
    "@ai-sdk/react": "^3.0.210",
    "@base-ui/react": "^1.6.0",
    "@e2b/code-interpreter": "2.6.1",
    "@mendable/firecrawl-js": "4.28.2",
    "@next/env": "16.2.9",
    "@nour/utils": "workspace:*",
    "@prisma/adapter-neon": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@statenour/lenses": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3",
    "@trpc/client": "^11",
    "@trpc/react-query": "^11",
    "@trpc/server": "^11",
    "@types/pg": "8.20.0",
    "ai": "6.0.162",
    "braintrust": "3.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "4.4.0",
    "geist": "^1.7.2",
    "googleapis": "^171.4.0",
    "inngest": "4.7.0",
    "ioredis": "^5.11.1",
    "livekit-client": "2.19.2",
    "livekit-server-sdk": "2.15.5",
    "lucide-react": "^0.577.0",
    "mammoth": "1.12.0",
    "nanoid": "^5.1.15",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.30",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.14.0",
    "server-only": "0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.184.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.184.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.2.6",
    "glob": "^13.0.6",
    "inngest-cli": "1.19.4",
    "postcss": "^8.5.3",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
