{
  "name": "@statenour/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "node -e \"const fs = require('fs'); try { fs.rmSync('.next', { recursive: true, force: true }); } catch(e) {}\" && cross-env PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate && next build",
    "build:local": "node -e \"const fs = require('fs'); try { fs.rmSync('.next-prod', { recursive: true, force: true }); } catch(e) {}\" && cross-env PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 NEXT_DIST_DIR=.next-prod prisma generate && cross-env NEXT_DIST_DIR=.next-prod next build",
    "analyze": "cross-env PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 ANALYZE=true NEXT_DIST_DIR=.next-prod prisma generate && cross-env ANALYZE=true NEXT_DIST_DIR=.next-prod next build",
    "build:check": "node -e \"const fs = require('fs'); try { fs.rmSync('.next-prod', { recursive: true, force: true }); } catch(e) {}\" && cross-env NEXT_DIST_DIR=.next-prod next build",
    "build:push-schema": "prisma generate && prisma db push && next build",
    "verify:hard": "pnpm typecheck:raw && pnpm lint && pnpm test && pnpm check:env && pnpm check:runbooks && pnpm check:prompt-injection && pnpm check:audit-deps && pnpm check:lint-baseline && pnpm check:raw-sql && pnpm check:crons && pnpm check:soft-delete && cross-env STALE_DOCS_STRICT=1 pnpm check:stale-docs && pnpm prompt:size-check && pnpm exec prisma validate",
    "release:db": "prisma migrate deploy",
    "release:app": "node -e \"const fs = require('fs'); try { fs.rmSync('.next', { recursive: true, force: true }); } catch(e) {}\" && prisma generate && next build",
    "release:full": "pnpm verify:hard && pnpm release:db && pnpm release:app",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "audit:surfaces": "node scripts/audit-system-surfaces.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:raw": "tsc -p tsconfig.typecheck.json --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "check:env:prod": "tsx scripts/check-env.ts --prod",
    "verify:railway": "tsx ../../scripts/verify-railway-config.ts",
    "check:crons": "tsx scripts/verify-crons.ts",
    "seed:greene": "tsx prisma/seeds/seed-greene-all.ts",
    "seed:greene:check": "tsx prisma/seeds/seed-greene-all.ts --check",
    "check:stale-docs": "tsx scripts/check-stale-docs.ts",
    "check:runbooks": "tsx scripts/check-runbooks.ts",
    "check:raw-sql": "tsx scripts/audit-raw-sql-columns.ts",
    "check:secrets": "tsx scripts/scan-secrets.ts",
    "check:prompt-injection": "tsx scripts/scan-prompt-injection.ts",
    "check:lint-baseline": "tsx scripts/lint-baseline.ts --verify",
    "lint-baseline:snapshot": "tsx scripts/lint-baseline.ts --snapshot",
    "check:audit-deps": "tsx scripts/audit-deps.ts",
    "prompt:size-check": "tsx scripts/measure-prompt-size.ts --yes",
    "pins:smoke": "tsx scripts/smoke-pins.ts",
    "calibrate:dry": "tsx scripts/dry-run-auto-calibrate.ts --yes",
    "inngest:dev": "inngest-cli dev -u http://localhost:3001/api/inngest",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx tests/eval/run-suite.ts",
    "eval:memory": "tsx scripts/run-memory-evals.ts",
    "eval:live": "tsx tests/eval/run-suite.ts --live",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "bootstrap:repo": "powershell -ExecutionPolicy Bypass -File .\\scripts\\bootstrap_repo.ps1",
    "bootstrap:repo:dry": "powershell -ExecutionPolicy Bypass -File .\\scripts\\bootstrap_repo.ps1 -DryRun",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "obsidian:doctor": "tsx scripts/obsidian-engine-runner.ts doctor",
    "obsidian:ingest": "tsx scripts/obsidian-engine-runner.ts ingest",
    "obsidian:export": "tsx scripts/obsidian-engine-runner.ts export",
    "obsidian:sync": "tsx scripts/obsidian-engine-runner.ts sync",
    "obsidian:status": "tsx scripts/obsidian-engine-runner.ts status",
    "obsidian:watch": "tsx scripts/obsidian-engine-runner.ts watch",
    "graphify:manifest": "tsx scripts/build-graphify-manifest.ts",
    "graphify:ingest": "tsx scripts/ingest-graphify-findings.ts --manifest findings-manifest.json",
    "graphify:sync": "pnpm run graphify:manifest && pnpm run graphify:ingest",
    "research:pack": "tsx scripts/generate-source-pack.ts",
    "research:ingest": "tsx scripts/ingest-research-pack.ts",
    "research:notebooklm": "tsx scripts/ingest-notebooklm-output.ts",
    "postinstall": "prisma generate",
    "check:soft-delete": "tsx scripts/audit-soft-delete-filters.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "3.0.82",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.142",
    "@base-ui/react": "^1.3.0",
    "@browserbasehq/stagehand": "3.7.0",
    "@e2b/code-interpreter": "2.4.2",
    "@mendable/firecrawl-js": "4.28.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@next/env": "16.2.3",
    "@nour/ai-capabilities": "workspace:*",
    "@nour/social-assets": "workspace:*",
    "@nour/utils": "workspace:*",
    "@prisma/adapter-neon": "^7.6.0",
    "@prisma/client": "catalog:",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@statenour/lenses": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3",
    "@trpc/client": "^11",
    "@trpc/react-query": "^11",
    "@trpc/server": "^11",
    "ai": "6.0.162",
    "braintrust": "3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "4.4.0",
    "geist": "^1.7.0",
    "googleapis": "^171.4.0",
    "inngest": "4.4.0",
    "ioredis": "^5.10.1",
    "js-yaml": "5.2.0",
    "livekit-client": "2.19.0",
    "livekit-server-sdk": "2.15.3",
    "lucide-react": "catalog:",
    "mammoth": "1.12.0",
    "nanoid": "^5.1.7",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "2.4.5",
    "pg": "8.20.0",
    "playwright-core": "1.61.1",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "server-only": "0.0.1",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.184.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.4",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "0.184.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.2.10",
    "glob": "^13.0.6",
    "inngest-cli": "1.34.0",
    "postcss": "^8.5.16",
    "prisma": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
