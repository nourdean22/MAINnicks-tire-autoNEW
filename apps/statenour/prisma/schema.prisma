model Mission {
  id                 String        @id @default(cuid())
  title              String
  domain             MissionDomain
  status             MissionStatus @default(ACTIVE)
  priority           Int
  roiScore           Int
  neglectCost        Int
  successMetric      String?
  deadline           DateTime?
  weeklyReviewNote   String?       @db.Text
  manualRankOverride Int?
  /// 2026-06-09 · domain-anchored missions. systemKind="GENERAL" marks a
  /// system-managed per-domain anchor (the classifier's catch-all · protected
  /// from delete · excluded from project caps/counts). canonicalDomain is one
  /// of the 6 life domains (health/mind/business/social/spiritual/personal) —
  /// the real routing key; the legacy `domain` enum stays for back-compat.
  systemKind         String?       @map("system_kind") @db.VarChar(16)
  canonicalDomain    String?       @map("canonical_domain") @db.VarChar(24)
  /// v7.8 · Apr 29 · Universal audit. Who created vs who last
  /// updated. Values: "user" (explicit Nour click) · "nick" (AI
  /// agent action) · "cron:<jobName>" · "bridge:<system>" · "system".
  createdBy          String?       @default("system") @map("created_by") @db.VarChar(64)
  updatedBy          String?       @default("system") @map("updated_by") @db.VarChar(64)
  /// v7.9 · Apr 29 · Universal soft-delete. NULL = active. Set on
  /// "delete" so the row is recoverable. Default queries should
  /// filter `deletedAt: null` (use the lib/db/soft-delete helpers).
  deletedAt          DateTime?     @map("deleted_at")
  /// Full AI-generated plan data: phases, risks, pro tips, tools,
  /// decision points, done checklist, learning path, coach history.
  /// Populated by /api/ai/plan-project mode=plan, extended by mode=
  /// learn and mode=guide. Shape documented in lib/ai/project-plan.ts.
  planData           Json?

  /// Defines what sourceSystem is required for canClaimDone()
  completionCriteria Json?

  tasks              Task[]
  chatConversations  ChatConversation[]
  socialPublishItems SocialPublishQueue[]
  actionReceipts     ActionReceipt[]
  /// v10.0.421 · operator can link missions together (depends-on,
  /// blocks, related). MissionLink is an explicit join with optional
  /// relation type · self-referential many-to-many.
  linkedFrom         MissionLink[]        @relation("MissionLinkSource")
  linkedTo           MissionLink[]        @relation("MissionLinkTarget")
  /// Phase A.3 schema migration (2026-05-18) · explicit parent goal.
  /// Nullable so existing missions don't break · operator can backfill
  /// gradually via /goals UI or chat. When set, completing the mission
  /// can auto-bump the goal's progress. Per ADR-0012 + parked
  /// migration at prisma/migrations-pending/0001_mission_lifegoalid/.
  lifeGoalId         String?
  lifeGoal           LifeGoal?            @relation(fields: [lifeGoalId], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  /// Journal Brain (2026-06-01) — entries grounded/linked to this mission.
  journalDumps       BrainDump[]
  journalReflections Reflection[]
  journalSituations  SituationLog[]
  journalDecisions   DecisionReplay[]

  @@index([status, priority, deadline])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lifeGoalId])
}

/// v10.0.421 · mission-to-mission relationship join table.
/// Self-referential many-to-many · optional `relation` field
/// distinguishes "depends-on" / "blocks" / "related" without
/// requiring future schema migrations.
model MissionLink {
  id        String   @id @default(cuid())
  sourceId  String   @map("source_id")
  source    Mission  @relation("MissionLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String   @map("target_id")
  target    Mission  @relation("MissionLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  /// "depends-on" | "blocks" | "related" | null = related (default)
  relation  String?  @db.VarChar(32)
  /// Optional context about why these are linked.
  note      String?  @db.Text
  createdBy String?  @default("user") @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sourceId, targetId], map: "mission_links_source_target_key")
  @@index([sourceId], map: "mission_links_source_idx")
  @@index([targetId], map: "mission_links_target_idx")
  @@index([createdAt(sort: Desc)], map: "mission_links_created_at_idx")
  @@map("mission_links")
}

/// 2026-06-09 · classifier learning signal. Every time the operator re-files a
/// task into a different mission, we log (taskTitle → chosenMission/domain).
/// The task classifier injects the most-recent N as few-shot examples so it
/// adapts to the operator's filing patterns (no training/infra). Append-only.
model TaskClassificationCorrection {
  id              String   @id @default(cuid())
  taskTitle       String   @map("task_title") @db.Text
  chosenMissionId String?  @map("chosen_mission_id")
  /// Canonical domain of the chosen mission at re-file time (health/mind/…).
  domain          String?  @db.VarChar(24)
  createdBy       String?  @default("user") @map("created_by") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)], map: "task_classification_corrections_created_at_idx")
  @@map("task_classification_corrections")
}

model Task {
  id                      String         @id @default(cuid())
  title                   String
  missionId               String
  // v9.1.15 · changed Cascade → Restrict. Cascade was a Postgres-
  // level hard-delete that bypassed v7.9 universal soft-delete:
  // hard-deleting a Mission would silently nuke every child Task
  // even though the soft-delete pattern is the entire DB convention.
  // Restrict surfaces accidental hard-deletes as an error, forcing
  // the caller to use softDelete() (which respects the pattern).
  mission                 Mission        @relation(fields: [missionId], references: [id], onDelete: Restrict)
  status                  TaskStatus     @default(INBOX)
  nextPhysicalAction      String
  effort                  EffortBand
  roiScore                Int
  frictionScore           Int
  energyRequired          EnergyLevel
  context                 TaskContext
  delegatable             Boolean        @default(false)
  waitingOn               String?
  dueDate                 DateTime?
  lastTouchedAt           DateTime?
  driftRisk               Int            @default(0)
  /// 0-100, HIGHER = MORE URGENT (canonical polarity, 2026-08-19 —
  /// lib/scoring/task-priority.ts is the one scorer; a second
  /// lower-is-hotter convention previously split readers). Applies to
  /// manualPriorityOverride below too.
  autoPriority            Int?
  manualPriorityOverride  Int?
  autoPriorityExplanation String?        @db.Text
  finishCondition         String
  /// v7.8 · Apr 29 · Universal audit. Same shape as Mission.
  createdBy               String?        @default("system") @map("created_by") @db.VarChar(64)
  updatedBy               String?        @default("system") @map("updated_by") @db.VarChar(64)
  /// Unified loop kind — see LoopKind enum. Apr 15 rebuild:
  /// MasteryHabit + Commitment + OpenLoop collapsed into this column
  /// on the Task model. Old tables still exist but hold no data.
  loopKind                LoopKind       @default(ONCE)
  /// For PROMISE loops: who Nour promised (name, "myself",
  /// "Dania", "customer X", etc). Null for ONCE + DAILY.
  /// LEGACY free-text · superseded by personId below for known people
  /// (kept for "myself"/ad-hoc names that aren't PersonProfiles).
  promiseTo               String?
  /// 2026-06-01 · people↔tasks hard link. Structured upgrade of the
  /// free-text promiseTo: set when a task is a promise/commitment to a
  /// known PersonProfile, so /people can surface "open promises to X"
  /// and credit relationship reps on completion. Nullable · ON DELETE
  /// SET NULL (a deleted person leaves the task, just unlinked — the
  /// same orphan-not-cascade rule as goalId/parentTaskId).
  /// Backfilled from promiseTo name-match · migration 0005_people_overhaul.
  personId                String?        @map("person_id")
  person                  PersonProfile? @relation("PersonTasks", fields: [personId], references: [id], onDelete: SetNull)
  /// For DAILY loops: last time this item was checked off.
  lastCompletedAt         DateTime?
  /// For DAILY loops: consecutive days completed streak. Incremented
  /// on complete; resets to 1 if the gap since lastCompletedAt is
  /// > 1 day. Displayed as a flame in the loop list.
  streakCount             Int            @default(0)
  /// Optional link to a LifeGoal — lets loops trace up to the WHY
  /// so the UI can render lineage breadcrumbs. Nullable so legacy
  /// tasks and inbox items don't break. v11.0 W5.3 — upgraded from
  /// bare String? to a real @relation so Prisma can type-check
  /// goal fetches + cascading nulls on goal deletion.
  goalId                  String?
  goal                    LifeGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// 2026-06-01 · classifier-assigned mastery stat keys this task feeds
  /// (the 33 character-sheet stats). Set by `enrichTaskLinkage` when the
  /// task has no linked goal, so even goal-less tasks credit a real stat
  /// on completion. Empty = fall back to mission/goal-domain inference.
  statHints               String[]       @default([])
  /// 2026-06-01 · suggest-then-approve · when `enrichTaskLinkage` finds a
  /// LOW-confidence mission/goal match (below the silent-attach bar) it
  /// parks the proposal here instead of dropping it. The /missions chip
  /// shows it; the operator accepts (applies) or dismisses. Mirrors
  /// PersonProfile.pendingClassification. Shape: { missionId?, goalId?,
  /// statHints?, confidence, rationale, suggestedAt }.
  pendingClassification   Json?          @map("pending_classification")
  /// 2026-05-23 · task #22 · self-FK for subtask hierarchy (1 level
  /// per ADR-0017 amended Rule 4). Nullable · top-level tasks have
  /// NULL · subtasks point at their parent. ON DELETE SET NULL so a
  /// deleted parent leaves children as orphans rather than cascade-
  /// deleting (matches the goalId pattern · operator re-categorizes).
  /// Companion · prisma/migrations/20260523_task_parent_task_id/.
  parentTaskId            String?        @map("parent_task_id")
  parent                  Task?          @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children                Task[]         @relation("TaskChildren")
  /// For project-linked tasks: the phase name from the project plan.
  /// Populated when a task is created from ProjectPlanData.phases.
  phaseName               String?
  /// Wall-clock time actually spent on this task. Bumped when the
  /// task transitions from DOING → DONE via diff of startedAt to
  /// now. Used by the calibration loop that trains Nour's personal
  /// effort band estimates against reality.
  actualMinutes           Int            @default(0)
  /// Set when status → DOING. Cleared when the task leaves DOING.
  /// Used to compute actualMinutes delta on completion.
  startedAt               DateTime?
  /// v10.0.529.82 · Wave 26 · B1 · snooze persistence.
  /// When set, the task auto-resurfaces (status WAITING → READY) at
  /// or after this timestamp via the task-resurface cron (folded
  /// into mega-morning). Pre-Wave-26 the snooze UI parked tasks in
  /// WAITING with no wake-up timestamp — they never came back. The
  /// "snoozed N days" promise is now actually kept.
  snoozedUntil            DateTime?      @map("snoozed_until")
  /// 2026-06-06 · WEEKLY loops · which weekdays this task recurs on.
  /// 0=Sunday .. 6=Saturday (JS Date.getDay()). Empty for ONCE/DAILY/
  /// PROMISE. On completion checkTask snoozes a WEEKLY task to its next
  /// listed weekday (status WAITING + snoozedUntil); the task-resurface
  /// cron flips it back to READY on that day.
  recurringDays           Int[]          @default([]) @map("recurring_days")
  /// v7.9 · Apr 29 · Universal soft-delete.
  deletedAt               DateTime?      @map("deleted_at")
  completionNote          String?        @map("completion_note")
  outcomeScore            Int?           @map("outcome_score")
  outcomeRating           OutcomeRating? @map("outcome_rating")
  outcomeLesson           String?        @map("outcome_lesson") @db.Text
  /// v9.0-rc · Apr 30 · Proof attachment.
  /// Shape: { urls?: string[]; screenshots?: string[]; metrics?: Record<string,number>; notes?: string; observedAt?: string }
  /// Marking DONE without proof is allowed (soft enforcement) but the
  /// command-center-state's `noProofDay` risk fires when a busy day
  /// has zero proof attachments. See docs/project/V9-PLAN.md §1 v9.0-rc.
  proof                   Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  events                  TaskEvent[]

  @@index([missionId, status, dueDate])
  @@index([autoPriority, lastTouchedAt])
  @@index([loopKind, status])
  @@index([goalId, status])
  // 2026-06-01 · "open promises to person X" lookup on /people detail.
  @@index([personId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  // v10.0.529.82 · Wave 26 · B1 · task-resurface cron query is
  //   WHERE status='WAITING' AND snoozedUntil <= NOW() · this
  // composite makes it index-only.
  @@index([status, snoozedUntil])
  // 2026-05-23 · task #22 · subtask lookup index · "give me all
  // direct children of this parent" is the hot path for the
  // LoopStream indent renderer. Built CONCURRENTLY in the migration.
  @@index([parentTaskId])
}

/// Apr 26 · TaskEvent — append-only log of meaningful state changes
/// per task. Lets the brain layer learn completion patterns,
/// abandonment clusters, time-of-day signals without a polling
/// scan over the Task table. Keys are intentionally narrow + the
/// table is write-mostly so a 30-day window query stays fast.
///
/// kinds: created | started | completed | abandoned | reframed |
///        priority_changed | linked | unlinked | nudged | snoozed |
///        stale_flagged | revived | killed
model TaskEvent {
  id             String   @id @default(cuid())
  taskId         String
  // v9.1.15 · Restrict not Cascade — Task uses v7.9 soft-delete.
  // Hard-delete of a Task should NEVER happen via this FK; if it
  // does it's a bug worth surfacing as an error, not silently
  // nuking the event audit trail.
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  /// 2026-05-23 · Wave F · denormalized from Task.goalId. The
  /// per-goal event-feed query (services/goals.ts:75-82) was doing
  /// a cross-join on Task on every read · adds growing scan cost
  /// as Task grows. Denormalizing means a single-table range scan
  /// over (goalId, createdAt). Maintained by createTaskEvent +
  /// goal-relink trigger. Nullable because pre-Wave-F rows + tasks
  /// without a goal both exist.
  goalId         String?  @map("goal_id")
  kind           String
  /// Optional structured payload (e.g. priority_changed → { from, to }).
  payload        Json?
  /// Source surface (chat, page, cron, voice, etc) — for analytics.
  source         String?
  /// v7.7 · Apr 29 · Universal idempotency. Append-only event log —
  /// retries shouldn't multiply records. Auto-mintable from
  /// {taskId + kind + payload-hash + 5min-bucket}.
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  /// 2026-05-23 · Wave F · per-goal event feed · covers the
  /// services/goals.ts per-goal-event-timeline query.
  @@index([goalId, createdAt])
  @@map("task_events")
}

/// v8.0 · Apr 29 · Phase 2A — Universal entity-audit trail.
///
/// Generic provenance log: every meaningful mutation across the
/// system writes one row here. Lets the brain layer + admin UI
/// answer questions like:
///
///   · "Show me everything Nick has done to my goals this week"
///   · "What changed in this mission between Mon and Wed?"
///   · "Who soft-deleted this brain memory and why?"
///
/// Distinct from per-entity event logs (task_events, goal_events):
///   - TaskEvent/GoalEvent are domain-semantic ("started", "snoozed",
///     "priority_changed") — they exist for the brain pattern miner.
///   - EntityAudit is field-level provenance ("title: 'A' → 'B'") —
///     it exists for "what did you do, when, and why" queries.
///
/// Both can coexist; they answer different questions.
///
/// `entityType` uses the Prisma model key ("task", "lifeGoal",
/// "mission", "brainMemory", etc) to keep callers consistent.
///
/// `before` / `after` capture only the changed fields (diff), not
/// the whole row, so a 50-field row that changed `title` writes
/// `{title: oldVal}` / `{title: newVal}`. Saves bytes + makes the
/// log readable.
model EntityAudit {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String   @map("entity_id")
  /// One of: created | updated | soft_deleted | restored | purged
  action         String   @db.VarChar(32)
  /// Actor format from lib/db/actor.ts: user / nick / system /
  /// cron:<jobName> / bridge:<system>.
  actor          String   @db.VarChar(64)
  /// Diff: only fields that actually changed. Null for `created`
  /// (use `after` for the full create payload) and for soft-delete
  /// actions (the action itself is the change).
  before         Json?
  /// Diff: post-mutation values for the changed fields. Null for
  /// `soft_deleted` / `restored` / `purged`.
  after          Json?
  /// Optional human-readable reason ("user clicked archive",
  /// "auto-snoozed by cron:weekly-review", "Nick decided X because Y").
  reason         String?  @db.Text
  /// Source surface: api:goals.PATCH | service:tasks.update |
  /// chat:tool-call | cron:brain-cycle | bridge:nickstire-sync.
  source         String?
  /// v7.7 idempotency: collisions are silently dropped so retries
  /// don't multiply audit rows. Auto-mintable from
  /// {entityType + entityId + action + 5s-bucket}.
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("entity_audits")
}

model PersonalDailyLog {
  id                 String   @id @default(cuid())
  logDate            DateTime @unique @db.Date
  sleepHours         Decimal? @db.Decimal(4, 1)
  energyScore        Int?
  moodScore          Int?
  workoutCompleted   Boolean  @default(false)
  supplements        String?  @db.Text
  deepWorkBlocks     Int      @default(0)
  revenueMoves       Int      @default(0)
  driftIncidents     Int      @default(0)
  distractionFlag    Boolean  @default(false)
  socialFamilyAction Boolean  @default(false)
  dailyScore         Int?
  notes              String?  @db.Text
  tomorrowConstraint String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([logDate])
  @@index([createdAt])
  @@index([updatedAt])
}

model DailyExecutionState {
  id                  String     @id @default(cuid())
  stateDate           DateTime   @unique @db.Date
  dayState            DayState   @default(OPEN)
  currentCommand      String?
  currentTaskId       String?
  activeMissionId     String?
  activeEmpireLane    EmpireLane @default(MONEY)
  blockedReason       String?    @db.Text
  deferReason         String?    @db.Text
  lastResolvedCommand String?
  tomorrowFirstMove   String?
  recoveryQuota       Int        @default(5)
  recoveryTouches     Int        @default(0)
  missionMoved        Boolean    @default(false)
  shadowMode          Boolean    @default(false)
  openedAt            DateTime   @default(now())
  closedAt            DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([stateDate, dayState])
  @@index([activeEmpireLane, dayState])
  @@index([createdAt])
  @@index([updatedAt])
}

model StateLog {
  id                 String   @id @default(cuid())
  energyLevel        Int
  focusQuality       Int
  driftLevel         Int
  executionReadiness Int
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model RunnerNode {
  id              String          @id @default(cuid())
  nodeKey         String          @unique
  label           String
  status          ServiceState    @default(STARTING)
  version         String?
  lastHeartbeatAt DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workItems       WorkItem[]
  serviceHealth   ServiceHealth[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
}

model ServiceHealth {
  id             String       @id @default(cuid())
  serviceKey     String       @unique
  service        String
  status         ServiceState
  detail         String
  recoveryAction String?
  checkedAt      DateTime     @default(now())
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastDurationMs Int?
  metadata       Json?
  runnerNodeId   String?
  runnerNode     RunnerNode?  @relation(fields: [runnerNodeId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, checkedAt])
  @@index([runnerNodeId])
  @@index([createdAt])
  @@index([updatedAt])
}

model SystemSnapshot {
  id                     String       @id @default(cuid())
  scope                  String       @unique @default("global")
  headline               String
  focus                  String
  startupStatus          ServiceState
  startupSummary         String
  startupNextAction      String?
  startupBlockingService String?
  primaryMove            String
  nextActions            Json?
  queuePending           Int          @default(0)
  queueApproved          Int          @default(0)
  queueDiscarded         Int          @default(0)
  mirrorRecordCount      Int          @default(0)
  recoveryOpenCount      Int          @default(0)
  downloadsIncomingCount Int          @default(0)
  watchRecentEvents24h   Int          @default(0)
  backupCount            Int          @default(0)
  briefUpdatedAt         DateTime?
  generatedAt            DateTime     @default(now())
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model WorkItem {
  id             String         @id @default(cuid())
  type           WorkItemType
  status         WorkItemStatus @default(PENDING)
  idempotencyKey String?        @unique
