  publishUrls     String[]  @default([]) @map("publish_urls")
  kind            String    @default("post") // "post" | "thread" | "story" | "reel"
  source          String    @default("manual") // "nick" | "manual" | "statenour-pack"
  sourceMetadata  Json?     @map("source_metadata")
