model ChatConversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── ChatMessage Batch A · v7.6 · Apr 29 · Conversation enrichment ──
  /// Compressed running summary of older turns. Survives the chat
  /// shrinker so the model always has cross-session continuity even
  /// after the live messages window scrolls past.
  pinnedSummary String?   @map("pinned_summary") @db.Text
  /// Auto-extracted topic tags ["#brake-job", "#marketing-strategy"].
  /// Filterable from sidebar without scanning every message. JSON array
  /// (not native string[]) for forward-compat with weighted tags.
  topicTags     Json?     @map("topic_tags")
  /// Soft-archive — hides from default sidebar but searchable.
  archivedAt    DateTime? @map("archived_at")
  /// User-starred for quick pin in sidebar.
  starredAt     DateTime? @map("starred_at")
  /// Mute = no notifications surface from this conv (future-proof).
  mutedAt       DateTime? @map("muted_at")
  /// Last activity (message OR engagement event). Faster than MAX(message.createdAt) for sidebar order.
  lastActiveAt  DateTime? @map("last_active_at")
  /// Denormalized message count for sidebar perf. Updated on every
  /// chatMessage create. Eliminates the COUNT(*) per row.
  messageCount  Int       @default(0) @map("message_count")
  missionId     String?   @map("mission_id")

  messages ChatMessage[]
  mission  Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([archivedAt, lastActiveAt])
  @@index([starredAt])
  @@index([missionId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastActiveAt])
  @@map("chat_conversations")
}

/// v10.0.171 note · Most raw-SQL columns are now declared Unsupported
/// in their respective models so Prisma sees them and won't drop them.
/// EXCEPTION: `chat_messages.searchable_tsv` is a `GENERATED ALWAYS
/// AS (...) STORED` tsvector. Prisma 6 cannot model the generation
/// expression, so declaring it Unsupported triggers Prisma to ALTER
/// the column. Solution: leave it out of this schema. Defense layers:
///   1. v10.0.154 destructive-push pre-push gate blocks
///      `--accept-data-loss` in package.json + GHA workflows.
///   2. Schema sentinel (lib/db/schema-sentinel.ts) tracks existence.
///   3. Recovery: scripts/recover-pgvector-from-text.ts re-adds the
///      column + GIN index from raw SQL.
/// FTS queries hit the column via raw SQL in app/api/chat/search.
model ChatMessage {
  id             String                   @id @default(cuid())
  conversationId String                   @map("conversation_id")
  role           String
  content        String                   @db.Text
  model          String?
  tokenUsage     Json?                    @map("token_usage")
  // v10.0.171 · GENERATED ALWAYS AS tsvector. Prisma can't model the
  // generator expression, but `@default(dbgenerated(""))` with empty
  // string tells Prisma "do not manage the default" — sufficient to
  // stop drop-on-push. Querying via raw SQL only.
  searchable_tsv Unsupported("tsvector")? @default(dbgenerated())

  /// v7.3 · Apr 29 · Image / file attachments sent with the message.
  /// Shape: Array<{ type: "file", mediaType, url, filename? }>.
  attachments Json?

  // ════════════════════════════════════════════════════════════════
  // ChatMessage Batch A · v7.6 · Apr 29 · The 16-column upgrade
  // ════════════════════════════════════════════════════════════════

  // ── Idempotency ──
  /// Client-minted UUID per send. Server upserts on this — eliminates
  /// duplicate-fire bugs from silent-retry / network blips regardless
  /// of timing window. Indexed unique (per conv) so re-sends are O(1)
  /// matched and skipped. Nullable for legacy rows.
  clientMessageId String? @map("client_message_id")

  // ── Rich content tree ──
  /// Full UIMessage parts as the AI SDK v6 understands it. Captures:
  ///   - text:        { type:"text", text:"..." }
  ///   - file:        { type:"file", mediaType, url, filename? }
  ///   - reasoning:   { type:"reasoning", text:"..." } — Claude thinking
  ///   - tool-call:   { type:"tool-call", toolName, args, toolCallId }
  ///   - tool-result: { type:"tool-result", toolCallId, result }
  ///   - source:      { type:"source", url, title } — citations
  /// On reload we hydrate from this instead of the flat `content`
  /// string. `content` stays as the searchable plaintext digest.
  parts Json?

  // ── Streaming lifecycle ──
  /// "complete" | "partial" | "errored" | "aborted" | "truncated" | "unknown"
  /// partial = client closed the tab mid-stream OR network dropped.
  /// errored = stream finished with an error frame.
  /// aborted = user explicitly stopped via Stop button.
  /// truncated = model hit the length cap (finishReason="length") — cut off.
  /// unknown = finishReason was none of the known values.
  /// Allows resumption + accurate UI badging (no more "stuck spinner").
  streamingState String @default("complete") @map("streaming_state") @db.VarChar(16)

  // ── Branching / forking ──
  /// FK self-ref. When user regenerates a response, the new message
  /// has parentMessageId = the prior assistant turn. Tree-walker UI
  /// shows alternates as siblings; arrow keys cycle.
  parentMessageId String? @map("parent_message_id")
  /// UUID grouping sibling branches. All regenerations of one prompt
  /// share a branchId so the UI can show "version 2 of 3".
  branchId        String? @map("branch_id") @db.VarChar(36)

  // ── Edits ──
  /// Last edit timestamp. Null = never edited.
  editedAt    DateTime? @map("edited_at")
  /// Edit history: [{ at, prevContent, prevPartsHash }, ...]
  /// Bounded to last 10 versions (older trimmed by app).
  editHistory Json?     @map("edit_history")

  // ── Error structure ──
  /// When streamingState=errored, structured error: { code, message,
  /// provider, retryable, occurredAt }. Powers the "retry" chip UI.
  errorDetails Json? @map("error_details")

  // ── Provider observability ──
  /// "venice" | "ollama" | "openai" | "anthropic" | "fallback"
  provider            String? @db.VarChar(32)
  /// Why router picked this provider: "default" | "preferLargeContext"
  /// | "nourVoiceLane" | "fallback-after-rate-limit" | etc.
  routerReason        String? @map("router_reason") @db.VarChar(64)
  /// Total wall-time for the call (request → final token).
  latencyMs           Int?    @map("latency_ms")
  /// Time-to-first-token. The perceived-quality metric in 2026.
  firstTokenLatencyMs Int?    @map("first_token_latency_ms")

  // ── Cost tracking (denormalized from AiGeneration) ──
  /// Cost in cents (int). Pulled from the matching AiGeneration row
  /// when joinable. Allows native COUNT/SUM by-conversation queries
  /// without a tokenUsage JSON extract.
  costCents        Int? @map("cost_cents")
  /// Split out from tokenUsage Json so they're queryable directly.
  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")

  // ── Feedback ──
  /// User reaction: -1 thumbs-down · null neutral · +1 thumbs-up.
  /// (Future: 0-10 scale + per-axis ratings.) Powers router learning.
  feedbackScore Int? @map("feedback_score") @db.SmallInt

  // ── Search ──
  /// Pre-extracted plaintext from parts (text + reasoning + tool-result
  /// summaries). Fed into a tsvector GIN index by trigger / migration.
  /// Lets `/api/chat/search` use full-text search instead of LIKE.
  searchableContent String? @map("searchable_content") @db.Text

  // ── Attachments dedup ──
  /// SHA256 of sorted attachment URLs (or null when no attachments).
  /// Lets us recognize "same image uploaded twice" + dedup storage.
  attachmentsHash String? @map("attachments_hash") @db.VarChar(64)

  createdAt    DateTime         @default(now()) @map("created_at")
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Self-ref relation for branching tree
  parent   ChatMessage?  @relation("MessageBranch", fields: [parentMessageId], references: [id], onDelete: SetNull)
  children ChatMessage[] @relation("MessageBranch")

  @@unique([conversationId, clientMessageId], map: "chat_messages_conv_client_msg_id_uniq")
  @@index([conversationId, createdAt])
  @@index([conversationId, branchId])
  @@index([parentMessageId])
  @@index([streamingState, createdAt])
  @@index([provider, createdAt])
  @@index([feedbackScore])
  @@index([createdAt])
  @@map("chat_messages")
}

