  sourceSystem        String?   @map("source_system")
  verificationPayload Json?     @map("verification_payload")
  executedAt          DateTime? @default(now()) @map("executed_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([missionId])
  @@map("action_receipts")
}

// ── Intelligence OS Core ──

model RegisteredSource {
  id              String           @id @default(cuid())
  name            String
  url             String           @unique
  domain          String // ai | seo | competitor | automotive | macro
  sourceType      String // official | primary | secondary | community
  authScore       Float            @default(70.0) @map("auth_score")
  // Closed-loop learning audit (2026-07-22): stamped by the experiment-measure
  // resolver when a resolved experiment nudges this source's authScore. Lets an
  // operator SEE the loop working (samples fed in, last movement) and correct by hand.
  authScoreUpdatedAt DateTime?     @map("auth_score_updated_at")
  authScoreSamples   Int           @default(0) @map("auth_score_samples")
  refreshInterval Int              @default(86400) @map("refresh_interval") // refresh period in seconds
  lastFetched     DateTime?        @map("last_fetched")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  documents       SourceDocument[]
  experiments     Experiment[]

  @@index([domain])
  @@index([createdAt])
  @@map("intelligence_sources")
}

model SourceDocument {
  id         String              @id @default(cuid())
  sourceId   String              @map("source_id")
  source     RegisteredSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawContent String              @map("raw_content") @db.Text
  url        String?
  capturedAt DateTime            @default(now()) @map("captured_at")
  claims     IntelligenceClaim[]

  @@index([sourceId])
  @@index([capturedAt])
  @@map("source_documents")
}

model IntelligenceClaim {
  id                String         @id @default(cuid())
  documentId        String         @map("document_id")
  document          SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text              String         @db.Text
  category          String // research_claim | research_contradiction | research_action | research_question
  confidence        Float          @default(0.5)
  verificationScore Float          @map("verification_score")
  status            String         @default("unverified") // source_supported | weak_support | unverified
  bestMatchChunk    String?        @map("best_match_chunk") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  narrativeStatus   String?        @map("narrative_status") // emerging | peak | declining

  @@index([documentId])
  @@index([category, status])
  @@index([createdAt])
  @@map("intelligence_claims")
}

/// change-detection-lite sensor. One row per watched-page check; `changed` is
/// true when the content hash differs from that url's previous snapshot. The
/// engine OBSERVES only (Firecrawl scrape) and takes NO autonomous action —
/// see lib/intelligence/change-detection.ts.
model PageSnapshot {
  id          String   @id @default(cuid())
  url         String
  label       String?
  contentHash String   @map("content_hash")
  content     String   @db.Text
  changed     Boolean  @default(false)
  checkedAt   DateTime @default(now()) @map("checked_at")

  @@index([url, checkedAt])
  @@index([changed, checkedAt])
  @@map("page_snapshots")
}

model OpportunityLog {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  domain        String // ai | seo | competitor | automotive | macro
  impact        Float // 0 - 100
  urgency       Float // 0 - 100
  confidence    Float // 0.0 - 1.0
  reversibility Float // 0 - 100
  score         Float // calculated priority score
  status        String   @default("pending") // pending | accepted | declined | resolved
  // Closed-loop attribution (2026-07-22): the highest-authority supporting
  // source, denormalized here at scoring time so the accept -> experiment ->
  // authScore feedback leg has a source to credit/blame. Plain column, no FK
  // (the FK lives on Experiment.sourceId); nullable for legacy/unattributed rows.
  sourceId      String?  @map("source_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  experiment    Experiment?

  @@index([status, score(sort: Desc)])
  @@index([domain])
  @@index([createdAt])
  @@index([sourceId])
  @@map("opportunity_logs")
}

/// Closed-loop Experiment factory (2026-07-22). One row per ACCEPTED opportunity:
/// spawned by /api/intelligence/decisions/log, resolved by the daily
/// experiment-measure cron, whose decisive outcome nudges the attributed
/// source's authScore (bounded, reversible EWMA). Makes source trust LEARN from
/// whether accepted opportunities actually held up, instead of being static.
model Experiment {
  id             String            @id @default(cuid())
  // @unique -> at most one experiment per opportunity; also makes the accept-time
  // upsert idempotent (double-accept is a no-op).
  opportunityId  String            @unique @map("opportunity_id")
  opportunity    OpportunityLog    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // Copied from OpportunityLog.sourceId at spawn. Nullable: unattributed
  // opportunities skip the feedback leg. SetNull keeps the audit row on source delete.
  sourceId       String?           @map("source_id")
  source         RegisteredSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  hypothesis     String            @db.Text
  metric         String?           @db.Text
  baseline       Float?
  expectedEffect Float?            @map("expected_effect")
  // running -> measuring (atomically claimed by the resolver, prevents concurrent
  // double-scoring) -> held_up | failed | inconclusive.
  status         String            @default("running")
  actualResult   String?           @map("actual_result") @db.Text
  startedAt      DateTime          @default(now()) @map("started_at")
  dueAt          DateTime          @map("due_at")
  measuredAt     DateTime?         @map("measured_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([status, dueAt]) // resolver DUE query: status='running' AND dueAt <= now
  @@index([sourceId])
  @@map("experiments")
}

/// S4 (2026-07-28) · Intelligence Outcome Ledger — the learning layer's
/// missing half. Every substantive machine recommendation gets ONE row:
/// what generated it, when/where it was shown, what the operator did,
/// and whether it helped. Aggregates surfaces that lack outcome
/// tracking (brief headlines, chat decision surfacings); surfaces with
/// their own receipts (agenda, approvals, queue) are NOT duplicated
/// here — this ledger reads beside them, never instead of them.
model IntelligenceOutcome {
  id           String    @id @default(cuid())
  /// daily_brief | decision_surface | proactive_push | suggestion | prediction
  kind         String
  sourceEngine String    @map("source_engine")
  /// sha256[:16] of normalized summary — dedup + stable reference
  contentHash  String    @map("content_hash")
  summary      String    @db.Text
  evidenceRefs Json?     @map("evidence_refs")
  confidence   Float?
  shownAt      DateTime  @default(now()) @map("shown_at")
  shownSurface String    @map("shown_surface")
  decidedAt    DateTime? @map("decided_at")
  /// accepted | dismissed | edited | ignored (set by sweep after TTL)
  decision     String?
  resultRef    String?   @map("result_ref")
  outcomeAt    DateTime? @map("outcome_at")
  outcomeUseful Boolean? @map("outcome_useful")
  conversationId String? @map("conversation_id")
  traceId      String?   @map("trace_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([kind, shownAt])
  @@index([contentHash])
  @@map("intelligence_outcomes")
}

model BriefingLog {
  id        String   @id @default(cuid())
  briefType String   @map("brief_type") // daily | weekly | monthly
  content   String   @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([briefType, createdAt(sort: Desc)])
  @@map("briefing_logs")
}

enum AgendaItemCategory {
  WITNESSED_COMMITMENT
  STANDING_INTENTION
  CONTRADICTION
  NEGLECT_ALERT
  /// Spine-4 · Home follow-ups promoted from localStorage-only dismissal
  /// into the durable agenda ledger (source="follow_up", sourceId=hash).
  FOLLOW_UP
}

enum AgendaItemStatus {
  ACTIVE
  RESOLVED
  SNOOZED
  ARCHIVED
}

model AgendaItem {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  title        String
  description  String?            @db.Text
  category     AgendaItemCategory
  status       AgendaItemStatus   @default(ACTIVE)
  source       String // e.g. "chat", "journal", "prediction"
  sourceId     String?            @map("source_id")
  dueDate      DateTime?          @map("due_date")
  lastNudgedAt DateTime?          @map("last_nudged_at")
  escalateAt   DateTime?          @map("escalate_at")
  metadata     Json?

  @@index([status, category])
  @@map("agenda_items")
}

enum OutcomeRating {
  OUTSTANDING
  SATISFACTORY
  SUBSTANDARD
  FAILED
}

/// 2026-07-25 · durable outbox for post-turn chat work (audit P1).
/// The deferred pipeline (memory writes, receipts, journal ingest,
/// people intel …) was fire-and-forget: a crash mid-turn silently lost
/// it. Every turn now writes its frozen ctx here BEFORE running the
/// work inline (inline-first, durability added); the nightly drain
/// re-runs only orphans (status=pending past the grace window).
model PostTurnOutbox {
  id            String   @id @default(cuid())
  kind          String   @default("deferred-background")
  /// Frozen, serializable DeferredBackgroundCtx (log excluded; messages capped).
  payload       Json
  status        String   @default("pending") // pending | processing | done | failed
  attempts      Int      @default(0)
  lastError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  nextAttemptAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@map("post_turn_outbox")
}
