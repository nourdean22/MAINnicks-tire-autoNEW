/// v10.0.198 · Autonomous engine event log · extracted from BrainMemory.
///
/// Pre-extraction · BrainMemory(category="autonomous_event") with
/// one row per autonomous-engine rule fire (~62 rows seen in probe).
/// Append-only event stream — pure log data. Categorization made
/// every BrainMemory query pay for it.
///
/// Phase 1 schema + dual-write. Phase 2 cuts reads in /system/
/// autonomous-actions. Phase 3 drops legacy.
model AutonomousEvent {
  id           String   @id @default(cuid())
  /// Autonomous engine event id (idempotency key when supplied,
  /// falls back to internal cuid otherwise).
  eventId      String   @unique @map("event_id") @db.VarChar(80)
  ruleName     String   @map("rule_name") @db.VarChar(120)
  actionType   String?  @map("action_type") @db.VarChar(80)
  targetType   String?  @map("target_type") @db.VarChar(80)
  targetId     String?  @map("target_id")
  /// Outcome: success | dry-run | gated | failed | (free-form)
  result       String   @db.VarChar(40)
  errorMessage String?  @map("error_message") @db.Text
  /// Worker id of whichever brain-bus consumer fired the rule.
  worker       String?  @db.VarChar(80)
  firedAt      DateTime @default(now()) @map("fired_at")

  @@index([ruleName, firedAt(sort: Desc)])
  @@index([result, firedAt(sort: Desc)])
  @@index([firedAt(sort: Desc)])
  @@map("autonomous_events")
}

/// v10.0.198 · Semantic edge graph · extracted from BrainMemory.
///
/// Pre-extraction · BrainMemory(category="semantic_edge") with one
/// row per cosine-derived edge between brain memories. ~57 rows
/// today. Forced graph data through a KV store; queries that join
/// edges with their endpoint memories paid two BrainMemory scans.
///
/// Phase 1 schema + dual-write. Phase 2 cuts /brain/galaxy reads.
/// Phase 3 drops legacy.
model SemanticEdge {
  id           String   @id @default(cuid())
  fromMemoryId String   @map("from_memory_id")
  toMemoryId   String   @map("to_memory_id")
  fromCategory String   @map("from_category") @db.VarChar(64)
  toCategory   String?  @map("to_category") @db.VarChar(64)
  /// Cosine distance (0 = identical, 1 = orthogonal).
  distance     Float
  /// Convenience derived score: 1 - distance, clamped 0-1.
  score        Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Edge identity is the unordered pair (from, to). One row per
  /// directed pair to keep indexing simple; the graph layer can
  /// query both directions with two index lookups.
  @@unique([fromMemoryId, toMemoryId])
  /// Index for "what's connected to memory X" — the dominant query.
  @@index([fromMemoryId, score(sort: Desc)])
  @@index([toMemoryId, score(sort: Desc)])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("semantic_edges")
}

/// v10.0.197 · Tool-verb ratio telemetry · extracted from BrainMemory.
///
/// Pre-extraction · BrainMemory(category="telemetry_tool_verb") with
/// one row per chat turn capturing the tool-to-claim ratio (the
/// fabrication-defense signal: how many actions did the model claim
/// vs how many tools actually fired). Append-only, ~1 row per turn.
///
/// Phase 1 schema + dual-write. Phase 2 cuts reads (no readers yet
/// — the data was just being collected). Phase 3 drops legacy.
model ToolVerbRatio {
  id             String   @id @default(cuid())
  conversationId String?  @map("conversation_id")
  traceId        String?  @map("trace_id") @db.VarChar(40)
  ratio          Float
  toolsCount     Int      @map("tools_count")
  claimsCount    Int      @map("claims_count")
  hedged         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("tool_verb_ratios")
}

/// v10.0.194 · Tool telemetry aggregate · extracted from BrainMemory.
///
/// Pre-extraction lived in BrainMemory(category="tool_telemetry") with
/// metadata JSON holding totalCalls/successCount/failCount/etc and a
/// raw-SQL UPSERT to merge concurrent invocations. The category-abuse
/// pattern made indexing per-domain impossible (the 138-category
/// BrainMemory table grew an index by category but couldn't index
/// e.g. "tools by failure rate" without scanning).
///
/// Phase 1 (this commit) ships the model + dual-write so reads stay
/// on BrainMemory while we verify the new table populates correctly.
/// Phase 2 (v10.0.195) cuts over reads. Phase 3 (v10.0.196) soft-
/// deletes the legacy BrainMemory rows.
model ToolTelemetry {
  id              String    @id @default(cuid())
  /// Tool name (catalog key from lib/ai/tools/catalog.ts), unique.
  toolName        String    @unique @map("tool_name") @db.VarChar(120)
  /// Aggregate counters. Updated atomically per invocation via
  /// UPSERT in lib/ai/tool-telemetry.ts.
  totalCalls      Int       @default(0) @map("total_calls")
  successCount    Int       @default(0) @map("success_count")
  failCount       Int       @default(0) @map("fail_count")
  /// BigInt because at 1M+ calls × 10s avg this overflows Int32.
  totalDurationMs BigInt    @default(0) @map("total_duration_ms")
  /// Last 5 error messages (capped). Old entries fall off as new
  /// failures land. Size bounded so JSON column never bloats.
  lastErrors      Json      @default("[]") @map("last_errors")
  /// Ms-precision wall clock of the most recent invocation.
  lastCallAt      DateTime? @map("last_call_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// Pre-computed for "problem tools" queries — failCount * 100
  /// / totalCalls when totalCalls >= 10. Update via trigger or in
  /// the upsert path. Phase 2 wires the trigger.
  failureRatePct Float? @map("failure_rate_pct")

  /// Index for /system/tools dashboard sort by call volume.
  @@index([totalCalls(sort: Desc)])
  /// Index for problem-tools heuristic — flags tools with
  /// failureRatePct > 50 + totalCalls >= 10.
  @@index([failureRatePct(sort: Desc)])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("tool_telemetry")
}

model BrainMemory {
  id         String    @id @default(cuid())
  category   String // pattern, insight, preference, routine, anomaly, device_behavior
  key        String // unique identifier for dedup
  content    String    @db.Text
  confidence Float     @default(0.5)
  lastSeen   DateTime  @default(now()) @map("last_seen")
  seenCount  Int       @default(1) @map("seen_count")
  source     String // device_analysis, behavior_tracking, vision, manual
  expiresAt  DateTime? @map("expires_at")
  metadata   Json?
  /// v7.8 · Apr 29 · Universal audit. `source` was overloaded as a
  /// who-wrote-this proxy; createdBy formalizes it. Old rows keep
  /// "system" default; new writes specify "nick" / "user" / "cron:X".
  createdBy  String?   @default("system") @map("created_by") @db.VarChar(64)
  /// v7.9 · Apr 29 · Universal soft-delete. Distinct from `expiresAt`
  /// (which is for memory-decay TTL): `deletedAt` is for explicit
  /// human/AI delete, recoverable from the lib/db/soft-delete helpers.
  deletedAt  DateTime? @map("deleted_at")
  /// BDN-310 · 2026-08-14 · temporal validity + supersession.
  ///
  /// Distinct from all three existing time fields, and the distinction is
  /// the point: `expiresAt` = decay TTL (we stop trusting it), `deletedAt`
  /// = explicit removal (it should not have been there), `lastSeen` = when
  /// we last OBSERVED it. None of them can express "this was true, then
  /// stopped being true" — which is the difference between a system that
  /// remembers more and one that is wiser. A memory whose validity ended
  /// is not wrong and must not be deleted; it is the evidence that the
  /// thing CHANGED.
  ///
  /// `validUntil` NULL = still believed. `supersededById` points at the
  /// memory that replaced it, so the chain is walkable in both directions
  /// and a contradiction is preserved rather than silently merged.
  /// `lastVerifiedAt` is deliberately NOT lastSeen: recall touches
  /// lastSeen on every read, so it measures attention, not confirmation.
  ///
  /// Scope is intentionally narrow (commitments · identity · financial ·
  /// safety · active missions) — the gate is enforced in application code,
  /// not by the schema, so widening it later needs no migration.
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  lastVerifiedAt DateTime? @map("last_verified_at")
  supersededById String?   @map("superseded_by_id")
  /// Self-relation. SetNull, never Cascade: if the replacement is hard-
  /// deleted we want a detectable dangling pointer, not a cascade that
  /// erases the record that something changed. `supersedes` is a LIST
  /// because consolidation is the common case — several narrow memories
  /// collapsing into one broader one.
  supersededBy   BrainMemory?  @relation("MemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes     BrainMemory[] @relation("MemorySupersession")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([category, key])
  // BDN-310 · recall must cheaply exclude superseded rows. Partial-index
  // semantics are expressed in the hand-applied SQL; Prisma models the
  // plain index.
  @@index([validUntil])
  @@index([supersededById])
  @@index([category, confidence])
  @@index([expiresAt])
  // Apr 18: decay queries filter by lastSeen < 30d + confidence > 0.1.
  // Without this the hourly brain-cycle decay scans the full table;
  // it's 2K rows today but will bite at 20K+.
  @@index([lastSeen])
  // Apr 20: /api/brain/pinned + PinnedContextPanel both filter
  // category=pinned_user and order by updatedAt desc. Without this
  // compound index Postgres falls back to a seq scan on the whole
  // BrainMemory table (2K+ rows today, growing). Cheap to add.
  @@index([category, updatedAt])
  // v7 cleanup · Apr 28 · category-by-recency reads dominate brain
  // recall (live brain feeds, dashboard queries). Postgres planner
  // picked (category, confidence) for these and missed the createdAt
  // sort, forcing a sort-after-scan. Composite (category, createdAt)
  // gives an index-only scan for the recency reads.
  @@index([category, createdAt])
  // v9.1.15 · BrainMemory was the ONLY soft-delete model missing a
  // standalone deletedAt index. Every brain-recall query filters by
  // (category, deletedAt: null) — without this, Postgres scans the
  // category bucket and post-filters by deletedAt. Compound here
  // because category is always co-filtered.
  @@index([category, deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("brain_memories")
}

/// v10 Track E.5 · Agent call trace.
///
/// Closes the assessment row "Observability · needs agent trace
/// standardization." Every AI/agent call across the system gets one
/// row here with a shared traceId for chaining (chat → tool → brain
/// → audit) and a parentId for nesting.
///
/// AiGeneration tracks usage/billing per individual generation;
/// AgentTrace tracks the CALL CHAIN — the same operator request may
/// produce multiple AiGeneration rows (chat reply + auto-rename +
/// importance scorer all on the same chat turn) but ONE traceId.
///
/// Surface: /system/agent-trace (deferred) + powers cost
/// attribution, "why did NICK do X?" debugging, and cross-call
/// dependency analysis.
model AgentTrace {
  id           String    @id @default(cuid())
  /// Shared across all calls in one logical operator request.
  /// Mint with mintTraceId() at the top of the chain (chat route,
  /// cron handler, autonomous engine).
  traceId      String    @map("trace_id")
  /// Parent trace id when this call is nested. Top-level call has
  /// parentId === null.
  parentId     String?   @map("parent_id")
  /// chat | cron | autonomous | tool | journal | brain | other
  source       String
  /// Provider name (venice / ollama / openai / anthropic) when an
  /// AI call; null for pure-logic helpers.
  provider     String?
  /// Model id (e.g. claude-3-5-sonnet, qwen3-235b) when AI; null
  /// otherwise.
  model        String?
  /// Free-form label for the chain step ("auto-rename",
  /// "task-completion-detector", etc.)
  label        String
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  durationMs   Int?      @map("duration_ms")
  inputChars   Int?      @map("input_chars")
  outputChars  Int?      @map("output_chars")
  costCents    Int?      @map("cost_cents")
  toolCalls    Int       @default(0) @map("tool_calls")
  /// Error class when the call failed. Null on success.
  errorClass   String?   @map("error_class")
  errorMessage String?   @map("error_message") @db.Text
  /// Optional structured metadata (firstTokenAt, targetId, etc.).
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([traceId, startedAt])
  @@index([source, createdAt])
  @@index([provider, createdAt])
  @@index([errorClass, createdAt])
  @@index([createdAt])
  @@map("agent_traces")
}

/// v10 Track B.4 · Schema change ledger.
///
/// Closes the migration-history gap. The project uses `prisma db
/// push` (no migration files) so there's no SQL audit trail by
/// default. The schema-drift sentinel (v8.6) detects DRIFT but
/// can't tell you WHO changed WHAT WHEN.
///
/// Every schema change going forward gets a row here:
///   - destructive flag for ops review
///   - method (db_push / migrate / raw_sql)
///   - environment (local / preview / production)
///   - approval + applied audit
///   - rollbackPlan in case the change needs to be unwound
///
/// Surface: /system/schema-history dashboard reads this table.
model SchemaChangeLedger {
  id           String    @id @default(cuid())
  /// Human-mintable unique key, e.g. "v10.0.1-add-brain-bus-events".
  changeKey    String    @unique @map("change_key")
  title        String
  reason       String    @db.Text
  /// add_column | drop_column | alter_index | fk_change | enum_add | rename | other
  changeType   String    @map("change_type")
  /// db_push | migrate | raw_sql
  method       String
  /// local | preview | production
  environment  String
  sqlSummary   String?   @map("sql_summary") @db.Text
  prismaDiff   String?   @map("prisma_diff") @db.Text
  destructive  Boolean   @default(false)
  approvedBy   String?   @map("approved_by")
  appliedBy    String?   @map("applied_by")
  appliedAt    DateTime? @map("applied_at")
  rollbackPlan String?   @map("rollback_plan") @db.Text
  /// planned | applied | rolled_back | failed
  status       String    @default("planned")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([environment, appliedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("schema_change_ledger")
}

/// v10 Track B.2 · Durable brain-bus event log.
///
/// Closes the at-most-once delivery gap in v8.4 brain-bus.ts. The
/// LISTEN/NOTIFY layer is now ONLY a wake-up bell; the durable
/// truth lives in this table. Producer writes a row + fires NOTIFY.
/// Consumer reads pending rows on NOTIFY OR via polling backfill.
/// If the consumer is offline when NOTIFY fires, the row is still
/// here for the next polling cycle to pick up.
model BrainBusEvent {
  id          String    @id @default(cuid())
  topic       String
  eventType   String    @map("event_type")
  payload     Json
  /// Optional dedupe key — producers can mint via mintIdempotencyKey
  /// to suppress duplicate NOTIFYs of the same logical event.
  dedupeKey   String?   @unique @map("dedupe_key")
  /// v10.0.529.106 · Wave 61 · cross-lambda trace propagation.
  /// Pre-Wave-61 the AgentTrace chain broke whenever a chat request
  /// triggered an autonomous cron action in a different lambda
  /// invocation (the second lambda had no way to receive the
  /// originating traceId). Now: producers attach traceId when they
  /// emit; consumers read it back when they process. Indexed for
  /// /system/agent-traces drill-down across lambda boundaries.
  traceId     String?   @map("trace_id")
  /// Lifecycle: pending → processing → done (or failed → dead).
  status      String    @default("pending")
  attempts    Int       @default(0)
  /// When this event becomes eligible for processing (allows
  /// backoff scheduling for retries).
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  processedAt DateTime? @map("processed_at")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Polling backfill query: WHERE status='pending' AND availableAt<=NOW()
  @@index([status, availableAt])
  /// Per-topic recency reads (operator dashboard, debugging).
  @@index([topic, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
  /// v10.0.529.106 · Wave 61 · trace-chain lookups.
  @@index([traceId])
  @@map("brain_bus_events")
}

// Layer 4: Reflective Memory — meta-cognition across all other layers
// Watches patterns in BrainMemory, ExecutionInsight, DailyScore, BrainDump
// and generates higher-order insights about behavior over time.
model Reflection {
  id             String    @id @default(cuid())
  date           String // YYYY-MM-DD
  scope          String // daily, weekly, monthly, triggered
  category       String // behavior, business, health, mastery, drift, prediction
  insight        String    @db.Text // The reflection itself
  evidence       String    @db.Text // What data led to this insight
  confidence     Float     @default(0.7)
  actionable     Boolean   @default(false) // Does this need Nour's attention?
  acknowledged   Boolean   @default(false) // Has Nour seen/acted on this?
  connections    Json? // Links to related memories/patterns: { memoryIds: [], patternIds: [] }
  metadata       Json? // Source data, scores, timestamps
  /// v7.7 · Apr 29 · Universal idempotency. Reflection cron firing
  /// twice on the same day shouldn't produce two daily reflections —
  /// caller hashes from {date + scope + category}.
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  /// v7.9 · Apr 29 · Universal soft-delete.
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Journal Brain (2026-06-01) — grounding/scoring spine · docs/journal-brain-redesign.md
  goalId         String?   @map("goal_id")
  missionId      String?   @map("mission_id")
  linkConfidence Float?    @map("link_confidence")
  linkStatus     String?   @map("link_status")
  enrichedAt     DateTime? @map("enriched_at")
  goal           LifeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  mission        Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([date, scope])
  @@index([category, confidence])
  @@index([actionable, acknowledged])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([goalId])
  @@index([enrichedAt])
  @@map("reflections")
}

// Layer 5: Predictive Memory — forecasts future behavior based on patterns
// Uses historical data to predict what will happen next and surface warnings.
model Prediction {
  id         String   @id @default(cuid())
  date       String // YYYY-MM-DD — when the prediction was made
  targetDate String   @map("target_date") // When the predicted event will occur
  category   String // behavior, business, health, drift, operational
  prediction String   @db.Text // What will happen
  basis      String   @db.Text // What data/patterns led to this prediction
  confidence Float    @default(0.6) // 0-1, increases when reinforced
  status     String   @default("pending") // pending, confirmed, disproven, expired
  outcome    String?  @db.Text // What actually happened (filled in later)
  /// v10.0.150 · May 03 · Forecast taxonomy. Distinguishes the four
  /// problem types the audit recommended:
  ///   · binary             — will X happen by date Y? (default)
  ///   · continuous         — what will the value be?
  ///   · interval           — what's the likely range?
  ///   · next_best_action   — which option to pick?
  /// Backfilled to "binary" because every existing Prediction was
  /// shaped that way (status=confirmed/disproven). New predictions
  /// must declare kind explicitly.
  kind       String   @default("binary")
  /// v10.0.150 · Brier score = (confidence - outcome)² for binary
  /// predictions. Computed at resolution time by outcome-tracker.
  /// Lower is better; 0 = perfect, 0.25 = naive 50/50 guess, >0.25
  /// is worse than coin-flip. Null until resolved.
  brierScore Float?   @map("brier_score")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([status, targetDate])
  @@index([category, confidence])
  @@index([kind, status])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("predictions")
}

// Layer 6: Relational Graph — maps connections between entities
// Connects memories, people, decisions, commitments, and outcomes.
model MemoryEdge {
  id           String   @id @default(cuid())
  sourceType   String   @map("source_type") // memory, reflection, prediction, commitment, decision, person, loop
  sourceId     String   @map("source_id")
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  relationship String // causes, blocks, supports, contradicts, relates_to, leads_to, depends_on
  strength     Float    @default(0.5) // 0-1, reinforced over time
  evidence     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceType, sourceId, targetType, targetId, relationship])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationship])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("memory_edges")
}

// ═══════════════════════════════════════════════════════════
// TREE BRANCHES — Layers 7-12: The Thinking Memory
// ═══════════════════════════════════════════════════════════

// Branch A: Self-Awareness (extends L4 Reflective)
// L7: Contradiction Detector — catches conflicts between stated vs actual behavior
model Contradiction {
  id          String    @id @default(cuid())
  date        String
  claimSource String    @map("claim_source") // what Nour said/believed (brain_dump, chat, commitment)
  claimId     String?   @map("claim_id")
  claim       String    @db.Text // "I'm disciplined" or "I follow up on every lead"
  reality     String    @db.Text // "Discipline score avg 3.2/10 last 7 days"
  gap         String    @db.Text // "Gap: stated 8/10, measured 3.2/10"
  severity    String    @default("moderate") // mild, moderate, severe, critical
  category    String // identity, business, health, commitment, habit
  resolved    Boolean   @default(false)
  resolvedHow String?   @map("resolved_how") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 2026-05-23 · Wave F · was missing · updateMany() callers had no
  /// way to track when severity / resolved transitioned · the brain
  /// pattern miner couldn't sort by "recently changed" for review.
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// 2026-05-23 · Wave F · soft-delete · was hard-delete via deleteMany()
  /// which lost the audit trail. Dismissing a contradiction now flips
  /// deletedAt instead. Consumers filter with `deletedAt: null`.
  deletedAt   DateTime? @map("deleted_at")

  @@index([date, category])
  @@index([resolved])
  @@index([createdAt])
  /// 2026-05-23 · Wave F · the resolved-by-category dashboard hit (
  /// SELECT * WHERE resolved=false AND category='identity') was a
  /// full table scan because no composite index covered (resolved,
  /// category, createdAt). At ~10k rows this is a 200ms+ query · with
  /// the index it's a 5ms index range scan.
  @@index([resolved, category, createdAt])
  @@index([deletedAt])
  @@map("contradictions")
}

// L8: Identity Evolution — tracks WHO Nour is becoming over time
// v7.9 · Apr 29 — `date` dropped from @unique. The soft-delete pattern
// needs to support "redo today's snapshot": a soft-deleted row holding
// the unique slot would block the cron from re-emitting. Daily-uniqueness
// is now enforced in app code via `findFirst({date, deletedAt:null})`.
model IdentitySnapshot {
  id            String    @id @default(cuid())
  date          String // YYYY-MM-DD — was @unique pre-v7.9; now @@index only
  coreValues    Json // { discipline: 0.4, creativity: 0.8, ... } — measured, not stated
  strengths     Json // Top 5 strengths with evidence
  blindSpots    Json // Top 3 blind spots with evidence
  trajectory    String    @db.Text // "Moving toward X, away from Y"
  deltaFromLast String?   @map("delta_from_last") @db.Text // What changed since last snapshot
  masterySelf   Float     @default(0) @map("mastery_self") // Overall self-mastery score 0-10
  /// v7.9 · Apr 29 · Universal soft-delete. Hide the prior snapshot to
  /// let the cron re-emit today's row cleanly without losing the audit
  /// trail of the original computation.
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([date])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("identity_snapshots")
}

// Branch B: Foresight (extends L5 Predictive)
// L9: Simulation Engine — "if X, then cascade Y→Z→W"

// L10: Causal Engine — WHY patterns repeat, root cause chains
model CausalChain {
  id           String   @id @default(cuid())
  date         String
  effect       String   @db.Text // The observable pattern/problem
  rootCause    String   @db.Text // The deepest "why"
  chain        Json // Array of { cause, effect, evidence } — the full chain
  frequency    Int      @default(1) // How many times this chain has been observed
  lastSeen     DateTime @default(now()) @map("last_seen")
  intervention String?  @db.Text // What could break this chain
  broken       Boolean  @default(false) // Has the chain been successfully broken?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([frequency])
  @@index([broken])
  @@index([createdAt])
  @@index([lastSeen])
  @@map("causal_chains")
}

// Branch C: Social Intelligence (extends L6 Relational)
// L11: People Intelligence — deep profiles on key people
model PersonProfile {
  id               String    @id @default(cuid())
  name             String    @unique
  role             String // employee, customer, vendor, family, competitor, advisor, friend, close_friend, mentor, mentee, ex_friend, acquaintance, network_only, romantic, ex_romantic, enemy, rival
  relationship     String    @db.Text // How they relate to Nour
  patterns         Json? // Behavioral patterns observed
  trustScore       Float     @default(0.5) @map("trust_score") // 0-1
  leverageNotes    String?   @map("leverage_notes") @db.Text // Strategic positioning
  lastInteraction  DateTime? @map("last_interaction")
  interactionCount Int       @default(0) @map("interaction_count")
  metadata         Json?
  // 2026-06-06 · origin + contact (feature #5). source = who created this
  // profile (operator|agent|digest) -> shop-vs-personal is structural.
  // phone/email = stored contact identity (displayed; NOT a match key).
  source           String?
  phone            String?
  email            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // 2026-05-27 · Power Atlas Phase 0 ── core lifecycle ──
  status           String    @default("active") @map("status")
  blownUpAt        DateTime? @map("blown_up_at")
  blowUpReason     String?   @map("blow_up_reason") @db.Text
  birthday         String? // ISO date "1985-03-14" · year may be 1900 placeholder if unknown
  anniversary      String?
  dossierMd        String?   @map("dossier_md") @db.Text
  dossierUpdatedAt DateTime? @map("dossier_updated_at")
  cadenceDays      Int?      @map("cadence_days")
  deletedAt        DateTime? @map("deleted_at")

  // 2026-05-27 · Power Atlas Phase 0 ── Greene corpus ──
  greeneType      String?  @map("greene_type")
  applicableLaws  Int[]    @default([]) @map("applicable_laws")
  darkTraits      String[] @default([]) @map("dark_traits")
  seducerType     String?  @map("seducer_type")
  mentorshipRole  String?  @map("mentorship_role")
  currentStrategy String?  @map("current_strategy")

  // 2026-05-27 · Power Atlas Phase 0 ── power dynamics ──
  powerBalance           Float   @default(0.0) @map("power_balance")
  /// 2026-05-27 · Power Atlas Phase 2 · operator-mandated safety. When
  /// true, Phase 3 auto-compute MUST SKIP this profile (operator's
  /// manual slider value is sticky). Set by `updatePowerBalance`
  /// mutation when the operator drags the gauge slider.
  powerBalanceManualLock Boolean @default(false) @map("power_balance_manual_lock")

  // 2026-05-27 · Power Atlas Phase 2 (columns added now to avoid Phase 2 migration) ──
  behavioralFingerprint Json? @map("behavioral_fingerprint")
  psychographicLadder   Json? @map("psychographic_ladder")
  lastArcPlan           Json? @map("last_arc_plan")
  powerPlaysHistory     Json? @map("power_plays_history")

  /// 2026-06-01 · suggest-then-approve classifier. The people-intelligence
  /// engine writes its proposed { role, leverageNotes, trustAdjustment,
  /// basis, suggestedAt } HERE instead of silently overwriting the real
  /// fields. The operator accepts (applies + clears) or dismisses (clears)
  /// from the /people detail panel. Null = no pending suggestion.
  pendingClassification Json? @map("pending_classification")

  ledger RelationshipLedger[]
  plays  RelationshipPlay[]
  tasks  Task[]               @relation("PersonTasks")

  @@index([role])
  @@index([trustScore])
  @@index([status])
  @@index([role, status])
  @@index([birthday])
  @@index([cadenceDays])
  @@index([greeneType])
  @@index([powerBalance])
  @@index([powerBalanceManualLock])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("person_profiles")
}

/// 2026-05-27 · Power Atlas Phase 0 · per-person event log.
/// Each row = one deposit/withdrawal/blow-up/etc. Signed `amount` ·
/// no kind enum (sign tells the story). `source` distinguishes auto
/// (gmail/calendar/chat) from manual (operator typed it).
model RelationshipLedger {
  id       String        @id @default(cuid())
  personId String        @map("person_id")
  person   PersonProfile @relation(fields: [personId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  amount    Int
  note      String   @db.Text
  source    String // gmail | calendar | chat | telegram | manual | auto | greene_play

  metadata Json?

  @@index([personId, createdAt])
  @@index([source])
  @@index([createdAt])
  @@map("relationship_ledger")
}

/// 2026-05-27 · Power Atlas Phase 2 (table added in Phase 0 migration
/// to avoid Phase 2 schema work) · log of power-plays operator executed.
/// kind enum: arc_plan | message_draft | scarcity_play | reciprocity_assess
model RelationshipPlay {
  id       String        @id @default(cuid())
  personId String        @map("person_id")
  person   PersonProfile @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")
  kind        String
  inputCtx    Json     @map("input_ctx")
  output      Json
  outcome     String?
  outcomeNote String?  @map("outcome_note") @db.Text

  @@index([personId, createdAt])
  @@index([kind])
  @@map("relationship_plays")
}

model AutomationRule {
  id         String    @id @default(cuid())
  name       String
  trigger    Json // { type: "device_state"|"time"|"pattern"|"brain_decision", conditions: {...} }
  actions    Json // [{ deviceId, command, params }]
  enabled    Boolean   @default(true)
  priority   Int       @default(5) // 1=highest
  createdBy  String    @map("created_by") // nour, brain, system
  lastFired  DateTime? @map("last_fired")
  fireCount  Int       @default(0) @map("fire_count")
  cooldownMs Int       @default(60000) @map("cooldown_ms")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("automation_rules")
}

model ErrorLog {
  id        String   @id @default(cuid())
  level     String // error, warn, fatal
  message   String
  stack     String?  @db.Text
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level, createdAt])
  @@index([createdAt])
  @@map("error_logs")
}

// ============================================
// SUPPLIER INTEGRATION MODELS
// ============================================

// ── Quote Templates & Bundles ─────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════════
// HIRING & APPOINTMENTS
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// PROJECTION ENGINE
// ═══════════════════════════════════════════════════════════════════════

model LifeGoal {
  id             String    @id @default(cuid())
  domain         String // business, fitness, finance, personal, career
  title          String // "Hit $15K revenue this month"
  metric         String // revenue, weight, savings_balance
  targetValue    Float // 15000
  currentValue   Float     @default(0)
  unit           String    @default("") // $, lbs, sessions, %
  deadline       DateTime?
  status         String    @default("active") // active, achieved, missed, paused
  progress       Float     @default(0) // 0-100%
  achievedAt     DateTime?
  /// v7.8 · Apr 29 · Universal audit.
  createdBy      String?   @default("system") @map("created_by") @db.VarChar(64)
  updatedBy      String?   @default("system") @map("updated_by") @db.VarChar(64)
  /// Time horizon for this goal. Lets the Plan mode group goals by
  /// the timeframe Nour is actually thinking in (today, this week,
  /// this month, this quarter, this year, lifetime). Nullable for
  /// backward compat with records that predate the Apr 15 rebuild.
  horizon        String? // DAY | WEEK | MONTH | QUARTER | YEAR | LIFE
  /// Why this goal matters — the "so that" clause. Written once,
  /// surfaced when Nour is about to drop/skip the goal so he sees
  /// the original motivation before cutting.
  why            String?   @db.Text
  /// AI-generated tactical plan attached to this goal. Populated by
  /// /api/ai/suggest-goals and /api/ai/plan-goal. JSON shape:
  ///   { steps: string[], risks: string[], metric_updates: {...} }
  planData       Json?
  /// Time budget for the horizon. Used by Plan mode to surface
  /// overcommitment ("15 week goals at 3h each = 45h > 40h week").
  estimatedHours Int?
  /// Coaching history — array of { at, read, nextAction, blocker, risks }
  /// entries appended by POST /api/ai/coach-goal. Latest shows at
  /// the top of the goal row in Plan mode.
  coachLog       Json?
  /// v7.9 · Apr 29 · Universal soft-delete. Goals get archived all the
  /// time (priorities shift); soft-delete preserves the history so the
  /// brain layer can still mine "goals Nour stopped pursuing" patterns.
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Ambition Engine (2026-05-30) · applied to prod via /api/system/apply-pending-migration ──
  /// Progress semantics + card shape: metric (target/unit) · milestone
  /// (checklist %) · narrative (Nick + reflection scored, no fake target).
  kind             String    @default("metric")
  /// Compounding ladder — the higher-horizon goal this ladders into. Self-relation below.
  parentGoalId     String?
  /// Sam/YC · conviction 1-5 ("devastated to lose"). Force-ranks; surfaces zombies.
  conviction       Int?
  /// Elon · "tenx" | "incremental" ambition tag.
  ambition         String?
  /// Elon · question-the-requirement ritual timestamp (anti-stale core).
  lastChallengedAt DateTime?
  /// Annie Duke · pre-committed if-then exit: kill if <killCriteria> by <killBy>.
  killCriteria     String?
  killBy           DateTime?
  /// Atomic Habits · identity line for narrative goals ("the man who…").
  identityLine     String?

  /// v11.0 W5.3 — back-reference for Task.goal. Enables
  /// `prisma.lifeGoal.findMany({ include: { tasks: true } })`.
  tasks              Task[]
  events             GoalEvent[]
  /// Phase A.3 schema migration (2026-05-18) · back-ref for
  /// Mission.lifeGoalId · enables `lifeGoal.findMany({ include:
  /// { missions: true } })` for the /goals page sidebar.
  missions           Mission[]
  /// Ambition Engine · goal↔mastery-stat spine + the ladder self-relation.
  statLinks          GoalStat[]
  /// Journal Brain (2026-06-01) — entries grounded/linked to this goal.
  journalDumps       BrainDump[]
  journalReflections Reflection[]
  journalSituations  SituationLog[]
  journalDecisions   DecisionReplay[]
  parent             LifeGoal?        @relation("GoalLadder", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children           LifeGoal[]       @relation("GoalLadder")

  @@index([domain, status])
  @@index([horizon, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([parentGoalId])
  @@map("life_goals")
}

/// 2026-05-30 · Ambition Engine spine. A goal declares which mastery stats
/// it levels (weighted). A completed Task.goalId-tagged rep credits XP to
/// those stats via the leveling engine.
model GoalStat {
  id        String   @id @default(cuid())
  goalId    String
  goal      LifeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Stat key from lib/mastery/config (e.g. "sales", "leadership", "physical").
  statKey   String
  /// 0..1 — share of the goal's effort that levels this stat.
  weight    Float    @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([goalId, statKey])
  @@index([statKey])
  @@map("goal_stats")
}

/// Apr 26 · GoalEvent — append-only log of progress + lifecycle events
/// per goal. Mirror of TaskEvent. Lets the brain layer answer:
///   · "how often does Nour move this goal in a typical week?"
///   · "what's the running rate of progress increments?"
///   · "did the cron/coaching nudge land?"
/// without polling the LifeGoal table or scanning Task history.
///
/// kinds: created | updated | progress_logged | milestone_set |
///        milestone_hit | coached | paused | resumed | achieved |
///        missed | linked_project | unlinked_project
model GoalEvent {
  id             String   @id @default(cuid())
  goalId         String
  // v9.1.15 · Restrict not Cascade — LifeGoal uses v7.9 soft-delete.
  goal           LifeGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  kind           String
  /// Optional structured payload (e.g. progress_logged → { delta, after }).
  payload        Json?
  /// Source surface (page, chat, cron, task-completion-hook, etc).
  source         String?
  /// v7.7 · Apr 29 · Universal idempotency. Same pattern as TaskEvent.
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([goalId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("goal_events")
}

// ═══════════════════════════════════════════════════════════════════════
// REVIEW LOG — persistent morning/evening/weekly briefs
// ═══════════════════════════════════════════════════════════════════════

/// Each brief Nick generates gets stored here so Nour can look back
/// at last week's morning briefs or see patterns across reviews.
/// Populated by POST /api/ai/review; read by GET /api/reviews for
/// the Review mode history drawer.
model ReviewLog {
  id          String   @id @default(cuid())
  type        String // "morning" | "evening" | "weekly"
  generatedAt DateTime @default(now())
  headline    String?  @db.Text
  read        String?  @db.Text
  mit         String?  @db.Text
  wins        Json?
  risks       Json?
  action      String?  @db.Text
  questions   Json?
  rawPayload  Json? // full AI response for debugging + future re-parsing
  createdAt   DateTime @default(now())

  @@index([type, generatedAt])
  @@index([createdAt])
  @@map("review_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// BROKEN PROMISE LOG — failure pattern capture
// ═══════════════════════════════════════════════════════════════════════

/// When Nour marks a PROMISE loop as broken, he gets prompted for
/// the reason. The reason lives here so Nick can reference failure
/// patterns next time a similar promise is being set up.

// ═══════════════════════════════════════════════════════════════════════
// CAMERA INTELLIGENCE
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// AUTONOMOUS INTELLIGENCE
// ═══════════════════════════════════════════════════════════════════════

model AutonomousAction {
  id             String    @id @default(cuid())
  ruleName       String // "auto_followup_expired_quote", "auto_score_applicant"
  trigger        String // what triggered this action
  actionType     String // send_email, send_telegram, update_record, create_record, adjust_pricing
  targetType     String? // quote, applicant, customer, device
  targetId       String? // the ID of the affected record
  payload        Json? // what was done
  approval       String    @default("auto") // auto, pending, approved, rejected
  approvedBy     String? // "nour" or "system"
  executedAt     DateTime?
  result         String? // success, failed, skipped
  error          String?
  /// v7.7 · Apr 29 · Universal idempotency. Caller-minted key (or
  /// hash of {ruleName + targetType + targetId + 5min-bucket}) so
  /// a cron firing twice — or a webhook retrying — produces ONE
  /// action row, not duplicates. NULL on legacy rows; new writes
  /// always populate. Unique partial index excludes the NULLs so
  /// back-compat is free.
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime  @default(now())

  @@index([ruleName, createdAt])
  @@index([approval, createdAt])
  // v7 cleanup · Apr 28 · health-digest counts actions by result over
  // the last 24h. Without (result, createdAt) it scans the whole
  // table for the WHERE result='success' AND createdAt >= cutoff
  // pattern. ~20K rows; bites at >100K.
  @@index([result, createdAt])
  @@index([createdAt])
  // v7.7 · Apr 29 · Idempotency unique. Migration uses a partial
  // index `WHERE idempotency_key IS NOT NULL` so legacy NULLs
  // don't block. Prisma can't express partial uniques in @@unique
  // — declared via raw SQL in the migration.
  @@map("autonomous_actions")
}

model DecisionReplay {
  id             String    @id @default(cuid())
  decisionId     Int? // link to MasteryDecision
  title          String
  context        String?   @db.Text
  choiceMade     String
  reasoning      String?   @db.Text
  reviewAt       DateTime // 30/60/90 day review date
  reviewed       Boolean   @default(false)
  outcome        String?   @db.Text // what happened since
  outcomeScore   Float? // -10 to 10: net positive or negative
  lesson         String?   @db.Text // what was learned
  reviewedAt     DateTime?
  /// v7.7 · Apr 29 · Universal idempotency. Auto-mintable from
  /// {decisionId + reviewAt} so re-scheduling a review doesn't
  /// accidentally double-create the replay row.
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime  @default(now())

  // Journal Brain (2026-06-01) — grounding/scoring spine · docs/journal-brain-redesign.md
  goalId         String?   @map("goal_id")
  missionId      String?   @map("mission_id")
  linkConfidence Float?    @map("link_confidence")
  linkStatus     String?   @map("link_status")
  enrichedAt     DateTime? @map("enriched_at")
  goal           LifeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  mission        Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([reviewAt, reviewed])
  @@index([createdAt])
  @@index([goalId])
  @@index([enrichedAt])
  @@map("decision_replays")
}

// ─── Journal Pattern Radar · ADR-0013 (Phase D · 2026-05-18) ────────────────
// Convergence detection over journal entries → named threads.
// Threads are self-organizing clusters of related entries across all 4
// journal sources (BrainDump · Reflection · SituationLog · DecisionReplay).
// Polymorphic membership via (entrySource, entryId) is intentional —
// the 4 sources are bounded and the existing /api/journal feed already
// does the same polymorphic merge. YAGNI on 4 separate join tables.

model JournalSettings {
  /// Single-row config (id = "singleton"). Tunable knobs for the Journal Brain.
  /// Edited by the Phase 2 settings panel; read via getJournalSettings() with
  /// safe fallback to these defaults when the row is absent.
  id                   String   @id @default("singleton")
  baselineXp           Float    @default(0.8) @map("baseline_xp")
  baselineEnabled      Boolean  @default(true) @map("baseline_enabled")
  qualityFloorChars    Int      @default(40) @map("quality_floor_chars")
