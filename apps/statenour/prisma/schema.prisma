// v10.0.148 · May 03 · Policy registry — the governance spine on top
// of every automation surface (cron / tool / slash / autonomous-action /
// webhook). Pre-fix the rules that decided which actions auto-fire vs
// queue for approval lived scattered across cron files, tool defs, and
// chat interceptors. There was no surface an operator could read to
// answer "what is allowed to fire automatically right now?"
//
// `id` is the canonical reference: `<surface>.<name>` (e.g. "cron.embed-
// backfill", "tool.send-email-via-resend", "slash.save"). For crons,
// `config/crons.ts` continues to hold the schedule/memory/category data
// — this table augments with governance fields. For non-cron surfaces
// (tools, slash commands, webhooks) this row IS the source of truth.
//
// Approval classes:
//   · auto      — runs without operator review (read-only, low risk)
//   · pending   — queues an AutonomousAction row needing approval first
//   · forbidden — coded but disabled (e.g. retired, never-allowed)
//
// `rollback` describes the undo path (e.g. "DELETE /api/x/:id" or
// "manual-only · contact stripe support") — null only for genuinely
// non-reversible actions.
model AutomationPolicy {
  id            String  @id // <surface>.<name>, e.g. "cron.embed-backfill"
  surface       String // "cron" | "tool" | "slash" | "autonomous-action" | "webhook"
  name          String // bare name without surface prefix
  objective     String  @db.Text // why this exists, longer than a description
  trigger       String // when it fires: cron expression, event name, manual, hook
  inputs        Json? // structured list of inputs/dependencies (env vars, tables, services)
  approvalClass String  @default("auto") // "auto" | "pending" | "forbidden"
  rollback      String? @db.Text // path/method to undo, or null if non-reversible
  successMetric String  @db.Text // how we know it worked (concrete + measurable)
  owner         String  @default("nour")
  enabled       Boolean @default(true)

  // Operational fields — populated by the surfaces themselves over
  // time. Lets the registry double as a quick health-at-a-glance.
  lastFiredAt DateTime?
  lastResult  String? // "success" | "failure" | "pending_approval" | "rolled_back"
  fireCount   Int       @default(0)

  // Fire history — chronological log of each fire (see AutomationPolicyFire)
  fires AutomationPolicyFire[]

  notes    String?  @db.Text
  metadata Json? // extension point for future fields
  tags     String[] @default([]) // e.g. ["high-risk", "external-write", "cost-bearing"]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([surface, enabled])
  @@index([approvalClass, enabled])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("automation_policies")
}

/// v10.0.169 · per-policy fire history. Append-only chronological log
/// of every AutomationPolicy fire (success or failure). Drives the
/// /system/policies/[id]/fires drill-down. Prisma can't reference the
/// pg `gen_random_uuid()` directly via @default — use cuid() (matches
/// the rest of the codebase's id convention) and let Prisma generate
/// client-side. Opposite-side relation field added on AutomationPolicy.
model AutomationPolicyFire {
  id            String           @id @default(cuid())
  policyId      String           @map("policy_id")
  /// 2026-05-27 · was onDelete: Cascade · changed to Restrict because
  /// AutomationPolicy is in the SOFT_DELETE_MODELS list (lib/db/
  /// soft-delete.ts:54). The whole point of soft-delete is to preserve
  /// the audit trail (operator can answer "this policy used to fire ·
  /// what did it do") — but a stray `prisma.automationPolicy.delete()`
  /// (bypassing softDelete()) cascaded the fire history into the void
  /// silently. Restrict forces any hard-delete to error loudly so the
  /// soft-delete pattern is enforced at the DB level.
  policy        AutomationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  firedAt       DateTime         @default(now()) @map("fired_at")
  result        String // "success" | "failure" | "pending_approval" | "rolled_back"
  resultMessage String?          @map("result_message") @db.Text
  durationMs    Int?             @map("duration_ms")
  metadata      Json? // any surface-specific payload

  @@index([policyId, firedAt])
  @@index([firedAt])
  @@map("automation_policy_fires")
}

/// v10.0.526 · Arc A Feature 3 · Voice Latency capture.
///
/// Per-stage latency events for every VAPI call. The sub-800ms voice-
/// agent target (per the voice-agents skill) breaks down into:
///   stt_start       · STT begins consuming caller audio
///   stt_end         · STT final transcript ready
///   llm_start       · LLM request dispatched (input ready)
///   llm_first_token · LLM emits first token (perceived "thinking" end)
///   tts_start       · TTS request dispatched
///   tts_first_byte  · TTS emits first audio byte (caller hears voice)
///   end_to_end      · derived fallback from createdAt → endedAt when
///                     per-layer data isn't available in the webhook
///
/// AgentTrace already covers LLM-side latency on calls that flow
/// through the chat pipeline · don't double-count there. This model
/// captures STT/TTS/network legs that AgentTrace can't see.
///
/// Surfaces · /api/system/voice-latency (Ultron tile) +
/// /api/cron/vapi-latency-sync (nightly ingestion).
model VoiceLatencyEvent {
  id          String   @id @default(cuid())
  callId      String   @map("call_id")
  assistantId String   @map("assistant_id")
  /// stt_start | stt_end | llm_start | llm_first_token | tts_start
  /// | tts_first_byte | end_to_end
  stage       String
  latencyMs   Int      @map("latency_ms")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([callId, stage])
  @@index([createdAt])
  /// 2026-05-23 · Wave F · per-assistant + per-stage latency dashboard
  /// query (lib/services/system-pages-b.ts voice metrics aggregation)
  /// was filtering by (assistantId, stage, createdAt) post-fetch. With
  /// this composite index it becomes an index range scan.
  @@index([assistantId, stage, createdAt])
  @@map("voice_latency_events")
}

