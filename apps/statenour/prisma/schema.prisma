/// ⚠️  RAW-SQL EXTRA COLUMNS · PRISMA WILL DROP THESE IF YOU --accept-data-loss
///
/// The live `vector_embeddings` table has THREE additional columns that
/// v10.0.171 · The drop trap closes itself.
///
/// Pre-fix (v10.0.148 → .169): Prisma could not model `vector(N)` types,
/// so the columns existed in the DB but not in this schema. Every
/// `prisma db push` saw "extra columns" and offered to drop 7,000+
/// vector rows. Three near-misses in 10 days. The recovery scripts
/// became part of the runbook, which means the runbook was already
/// the bug.
///
/// Now: declare the raw-SQL columns as `Unsupported(...)` so Prisma
/// SEES them. Prisma cannot generate client types for these (we still
/// query via raw SQL — `lib/db/pgvector.ts`, `lib/brain/semantic-link.ts`,
/// `app/api/cron/pgvector-backfill/route.ts`), but it ALSO will not
/// try to drop them. The data-loss warning disappears because there
/// is no data loss to detect.
///
/// Schema-sentinel still watches for existence (lib/db/schema-sentinel.ts)
/// as a defense-in-depth check.
///
/// Source-of-truth scripts (kept for emergencies, not routine):
///   · scripts/add-hnsw-index.ts          — original install (v10.0.90)
///   · scripts/recover-pgvector-from-text.ts — full recovery (v10.0.154)
///   · scripts/recover-pgvector-embedding-vec.ts — sister recovery (v10.0.155)
model VectorEmbedding {
  id                 String                       @id @default(cuid())
  sourceType         String // brain_memory, chat, customer, knowledge
  sourceId           String
  content            String                       @db.Text
  embedding          String                       @db.Text // JSON array of floats — survives if pgvector columns ever drop
  createdAt          DateTime                     @default(now())
  // v10.0.171 · raw-SQL columns Prisma now SEES but does not manage.
  // Querying these requires raw SQL; the declarations exist so
  // `prisma db push` leaves them alone instead of warning + dropping.
  embedding_vec      Unsupported("vector")?
  embedding_vec_1536 Unsupported("vector(1536)")?
  embedding_dim      Int?
  model              String?                      @db.VarChar(64)
  updatedAt          DateTime                     @updatedAt

  @@index([sourceType, sourceId]) // composite — fixes slow lookup queries
  @@index([sourceType])
  @@index([sourceId])
  @@index([createdAt])
  @@map("vector_embeddings")
}

