  BUSINESS
  PERSONAL
  HEALTH
  CONTENT
  FINANCE
}

enum MissionStatus {
  ACTIVE
  PAUSED
  COMPLETE
  KILLED
}

enum TaskStatus {
  INBOX
  READY
  DOING
  WAITING
  DONE
  ARCHIVED
}

/// Unified loop kind — replaces the old 3-table split of
/// MasteryHabit + Commitment + OpenLoop. A Task row IS everything
/// Nour tracks:
///   ONCE    — one-off task (default)
///   DAILY   — recurring daily habit (streaks live in auditEvent)
///   PROMISE — commitment to someone (promiseTo + dueDate)
enum LoopKind {
  ONCE
  DAILY
  PROMISE
  WEEKLY
}

