# NOUR OS — Environment Variables
# Copy this file to .env.local and fill in your values

# === REQUIRED (app works without these but in demo mode) ===
AUTH_SECRET=nour-os-local-dev-secret

# === DATABASE (existing Neon PostgreSQL for CRM features) ===
DATABASE_URL=
DIRECT_URL=

# === AI PROVIDERS ===
# Venice is primary, OpenAI is fallback. Ollama was removed when we moved fully to cloud.
AI_PROVIDER=venice
VENICE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === RUNNER ===
RUNNER_SHARED_SECRET=statenour-local-runner
RUNNER_USE_QUEUE=true

# === NOTION (Phase 6 — optional) ===
NOTION_API_KEY=
NOTION_TASKS_DB_ID=f201718322f74425aaf45020dfa87815

# === GOOGLE SHEETS (Phase 7 — optional) ===
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_CRM_ID=

# === TWILIO (SMS alerts — optional) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NOUR_PHONE_NUMBER=

# Set to 1 during local dev to bypass Google OAuth (useful when localhost
# isn't a registered redirect URI in Google Cloud Console). Prod ignores.
AUTH_FORCE_MOCK=
