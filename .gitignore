# Agent / AI tooling - local, per-machine; never shared to the repo.
# .serena/ = Serena MCP project config + cache + memories (its own
# .gitignore only covers /cache, leaving project.yml + memories/ committable).
# .claude/worktrees/ = transient git worktrees from using-git-worktrees.
# NOTE: do NOT ignore all of .claude/ - .claude/skills/ is tracked + shared.
.serena/
.claude/worktrees/
# .worktrees/ = the house worktree location (scripts/worktree-setup.ps1 -targetDir .worktrees/<name>);
# scripts/night-shift/run.ps1 creates .worktrees/night-shift-<date> under -RepoRoot and writes its
# run log to scripts/night-shift/logs/<date>.log. Neither is source.
.worktrees/
scripts/night-shift/logs/

# Local context packs and agent memory
docs/LOCAL-CONTEXT-PACK.md
.remember/

# 2026-07-11 · real customer PII — never commit (nickstire handleImportCustomerCSV;
# operator sets CUSTOMER_IMPORT_CSV_PATH). Git HISTORY still holds it — scrub
# separately with git-filter-repo + force-push (operator, out of band).
apps/nickstire/data/shopdriver-customers.csv
apps/nickstire/data/*customers*.csv

# runtime-produced media (registry + Drive vault are the durable layers)
apps/nickstire/data/generated/

# Python bytecode from skill scripts (.claude/skills/skill-fire-audit/scripts)
__pycache__/
*.pyc

# VAPI assistant-config snapshots (rollback artifacts; contain the transfer number)
apps/nickstire/vapi-snapshots/

# Higgsfield stock-fallback remediation ledger — local run state (reel_id ->
# detection/archive/regen/takedown/repost status). Never committed: it is
# resumable working state, not a durable record (the durable record is what
# it ARCHIVES, via storagePut, and the pre-delete-report.csv the operator is
# handed directly).
apps/nickstire/.remediation/

# camera-bridge operator config. `README.md` says to create it with
# `cp config.example.yaml config.yaml`, and a real one carries the shop ingest URL and
# the cloud device ids for this specific site -- deployment state, not source. It was
# NOT ignored, so the first operator to follow the README would have staged it.
camera-bridge/config.yaml
# ...and the same for a per-camera operator config. A second producer needs its own
# file rather than a second entry in the first: `metrics.port` is a property of the
# CONFIG, not of a camera, so two producers sharing one config both bind the same
# port and the second loses its metrics endpoint silently.
camera-bridge/config-*.yaml
camera-bridge/data/
# camera-bridge edge runtime, all machine-local by construction:
#   secrets/     DPAPI blobs, decryptable only by the user+machine that wrote them
#   logs/        producer stdout
#   edge-task.cmd  generated by install-edge-runtime.ps1 with THIS box's absolute paths
camera-bridge/secrets/
camera-bridge/logs/
# The wrapper name now carries the task name, so a second producer gets its own file
# rather than overwriting the first one's -- the glob has to follow.
camera-bridge/edge-task*.cmd
# Pinned OpenVINO weights, fetched by `python -m vision.fetch_models --dest ov_models`
# and verified by sha256 there. ~3.9 MB of binary that the pin already identifies.
camera-bridge/ov_models/
