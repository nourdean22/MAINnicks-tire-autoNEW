# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
*.dist

# Turborepo (local cache + daemon logs)
.turbo/
**/.turbo/

# Graphify — local code knowledge-graph output (graph.json/html, report, cache)
graphify-out/*
!graphify-out/GRAPH_REPORT.md
# nested per-scope graphs from ad-hoc runs — never commit
apps/**/graphify-out/
packages/**/graphify-out/

# Environment variables
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/**
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs · NOT 'logs/' or 'logs' alone — those match the
# apps/statenour/app/(mastery)/system/logs/ route directory and silently
# hide its page.tsx + the matching /api/system/logs/route.ts. Use
# anchored patterns + log-file extensions only.
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
*.bak

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/

# Manus platform artifacts
.manus/
.manus-logs/
.vercel
.env*.local

# Local artifacts
tunnel-url.txt
apps/statenour/logs/
*.yml.bak

.vercel
.cron-secret.local
.railway-token.local

# Agent / AI tooling - local, per-machine; never shared to the repo.
# .serena/ = Serena MCP project config + cache + memories (its own
# .gitignore only covers /cache, leaving project.yml + memories/ committable).
# .claude/worktrees/ = transient git worktrees from using-git-worktrees.
# NOTE: do NOT ignore all of .claude/ - .claude/skills/ is tracked + shared.
.serena/
.claude/worktrees/

# Local context packs and agent memory
docs/LOCAL-CONTEXT-PACK.md
.remember/
