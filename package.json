      "dompurify": ">=3.4.17 <4.0.0",
      "@grpc/grpc-js": ">=1.14.5 <2.0.0",
      "form-data": ">=4.0.6",
      "vite@^7.0.0": ">=7.3.5 <8.0.0",
      "tailwindcss>nanoid": "3.3.7",
      "qs": ">=6.14.2",
      "fast-xml-parser": ">=5.5.6",
      "@opentelemetry/api": "1.9.1",
      "axios": ">=1.20.0 <2.0.0",
      "fast-uri": ">=3.1.7 <4.0.0",
      "@hono/node-server": ">=1.19.13",
      "mermaid": ">=11.15.0",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "uuid": ">=11.1.1",
      "ip-address": ">=10.3.1 <11.0.0",
      "tmp": ">=0.2.6",
      "ws": ">=8.21.0",
      "mysql2": ">=3.23.1",
      "@opentelemetry/core@>=2.0.0 <2.9.0": ">=2.9.0",
      "@opentelemetry/propagator-jaeger@>=2.0.0 <2.9.0": ">=2.9.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "js-yaml@>=5.0.0 <5.2.2": ">=5.2.2",
      "brace-expansion@1": ">=1.1.20 <2.0.0",
      "brace-expansion@2": ">=2.1.6 <3.0.0",
      "brace-expansion@>=3.0.0": ">=5.0.8",
      "proxy-addr": ">=2.0.8 <3.0.0",
      "simple-git": ">=4.0.2",
      "@simple-git/argv-parser": ">=2.0.1",
      "follow-redirects": ">=1.16.1 <2.0.0",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": ">=0.8.15 <0.9.0",
      "@modelcontextprotocol/sdk": ">=1.32.0 <2.0.0",
      "browserslist": ">=4.28.7 <5.0.0",
      "tinypool": ">=2.1.2 <3.0.0"
    }
  }
}
