{
  "name": "nour-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo · apps/nickstire (Vite+Express+Drizzle/TiDB · nickstire.org) + apps/statenour (Next.js+Prisma/Neon · admin) + apps/worker (Express+node-cron · long-running). See AGENTS.md.",
  "scripts": {
    "nick": "pnpm --filter nicks-tire-auto",
    "stn": "pnpm --filter @statenour/web",
    "worker": "pnpm --filter @statenour/worker",
    "build:nick": "turbo run build --filter=nicks-tire-auto",
    "build:stn": "turbo run build --filter=@statenour/web",
    "build:worker": "turbo run build --filter=@statenour/worker",
    "build:all": "turbo run build",
    "build:affected": "turbo run build --affected",
    "test:nick": "turbo run test --filter=nicks-tire-auto",
    "test:stn": "turbo run test --filter=@statenour/web",
    "test:all": "turbo run test",
    "test:affected": "turbo run test --affected",
    "check:all": "turbo run check",
    "check:affected": "turbo run check --affected",
    "lint:all": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "verify:nick": "pnpm --filter nicks-tire-auto verify",
    "verify:state": "pnpm --filter @statenour/web verify:hard",
    "verify:affected": "turbo run check lint test --affected",
    "ci:affected": "turbo run check lint test build --affected",
    "agent:verify": "node scripts/agent-os/verify.mjs",
    "agent:parity": "node scripts/agent-os/check-adapters.mjs",
    "dev:doctor": "node scripts/dev/doctor.mjs",
    "dev:context": "node scripts/dev/context-pack.mjs",
    "dev:model-smoke": "node scripts/dev/model-smoke.mjs",
    "obsidian:plugins": "powershell scripts/install-cockpit-plugins.ps1",
    "obsidian:doctor": "pnpm --filter @statenour/web obsidian:doctor",
    "obsidian:ingest": "pnpm --filter @statenour/web obsidian:ingest",
    "obsidian:export": "pnpm --filter @statenour/web obsidian:export",
    "obsidian:sync": "pnpm --filter @statenour/web obsidian:sync",
    "obsidian:watch": "pnpm --filter @statenour/web obsidian:watch",
    "research:pack": "pnpm --filter @statenour/web research:pack",
    "research:ingest": "pnpm --filter @statenour/web research:ingest",
    "research:notebooklm": "pnpm --filter @statenour/web research:notebooklm",
    "social:asset": "pnpm --filter @nour/social-assets render",
    "social:verify": "pnpm --filter @nour/social-assets test"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@types/node": "25.9.4",
    "lefthook": "2.2.2",
    "rea-agents": "6.7.0",
    "sherif": "1.13.0",
    "syncpack": "15.3.3",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "apps/nickstire/patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "undici@^6.0.0": "6.29.1",
      "undici@^7.0.0": "7.30.1",
      "undici@^8.0.0": "8.12.3",
      "hono": ">=4.12.25",
