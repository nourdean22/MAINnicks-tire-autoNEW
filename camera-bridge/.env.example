# Copy to .env next to docker-compose.yml. Never commit .env.
# Shared secret for statenour ingest (header x-sync-key). Same value as Railway STATENOUR_SYNC_KEY.
STATENOUR_SYNC_KEY=replace-me

# MQTT credentials for visitd (created with mosquitto_passwd, see README "Mosquitto bootstrap").
MQTT_USERNAME=visitd
MQTT_PASSWORD=replace-me

# Substituted into frigate/config.yml by Frigate itself ({FRIGATE_RTSP_PASSWORD} / {FRIGATE_MQTT_PASSWORD}).
FRIGATE_RTSP_PASSWORD=replace-me
FRIGATE_MQTT_PASSWORD=replace-me
