{
  "name": "@nour/social-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Proprietary social asset generation engine utilizing Satori and resvg-js.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-fonts.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "render": "tsx src/cli.tsx"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "react": "catalog:",
    "satori": "^0.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.1",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
