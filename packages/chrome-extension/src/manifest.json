{
  "manifest_version": 3,
  "name": "Statenour · Brain Capture",
  "short_name": "Statenour",
  "version": "0.2.0",
  "description": "Capture a brain dump from any tab · Cmd+Shift+B · shows prior notes for this URL · syncs to your statenour brain via /api/brain/dump",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Statenour brain dump (Cmd+Shift+B)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://statenour-web-production.up.railway.app/*",
    "https://autonicks.com/*",
    "http://localhost:3000/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open brain-dump popup"
    }
  },
  "options_page": "options.html"
}
