{
  "name": "@nour/utils",
  "version": "0.2.0",
  "private": true,
  "description": "Shared TypeScript utilities used across apps/statenour, apps/nickstire, apps/worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "default": "./dist/cn.js"
    },
    "./with-timeout": {
      "types": "./dist/with-timeout.d.ts",
      "default": "./dist/with-timeout.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "echo 'no lint config yet · skip'"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
