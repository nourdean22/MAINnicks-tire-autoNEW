{
  "name": "@statenour/lenses",
  "version": "0.1.0",
  "description": "Strategic reasoning lenses for AI agents — a typed registry of 49 frameworks (first-principles, JTBD, Porter's five forces, inversion, north-star metric, etc.) with trigger regexes and prompt blocks. Drop in next to your system prompt and let the model pick the right lens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./frameworks": {
      "types": "./dist/frameworks/index.d.ts",
      "default": "./dist/frameworks/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "llm",
    "prompt-engineering",
    "strategic-thinking",
    "first-principles",
    "jobs-to-be-done",
    "system-prompt",
    "lens-registry"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
